---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "AI Receptionist for Roofing Companies";
const pageDescription = "Never miss a storm damage call again. AI Employees handle lead qualification, estimate scheduling, and emergency requests 24/7 for roofing contractors.";

const benefits = [
  {
    title: "Capture Every Storm Damage Call",
    description: "When storms hit, calls flood in. Your AI employee handles every single one — even at 3 AM — qualifying leads and scheduling estimates automatically.",
    icon: "cloud-lightning"
  },
  {
    title: "Qualify Leads Before You Call Back",
    description: "AI gathers property details, insurance information, damage descriptions, and preferred callback times. You call back with everything you need.",
    icon: "clipboard-check"
  },
  {
    title: "Schedule Estimates Automatically",
    description: "AI books inspection appointments directly on your calendar. Homeowners get confirmations and reminders without you lifting a finger.",
    icon: "calendar"
  },
  {
    title: "Handle Emergency Calls",
    description: "Tarping emergencies and urgent repairs get flagged immediately. AI can transfer to your emergency line or dispatch your on-call crew.",
    icon: "alert-triangle"
  },
  {
    title: "Follow Up on Every Lead",
    description: "Automated follow-up sequences keep leads warm. AI re-engages prospects who didn't book and nurtures them until they're ready.",
    icon: "refresh"
  },
  {
    title: "Collect Reviews After Every Job",
    description: "Happy customer? AI sends review requests at the perfect time. Watch your Google and Facebook ratings climb.",
    icon: "star"
  }
];

const faqs = [
  {
    question: "Can the AI answer questions about roofing materials and costs?",
    answer: "Yes. We train your AI on your specific services, materials, and typical price ranges. It can discuss shingle types, material options, and provide ballpark estimates while being clear that a proper inspection is needed for accurate pricing."
  },
  {
    question: "How does it handle insurance claim calls?",
    answer: "The AI can gather insurance company information, claim numbers, and damage details. It explains your process for working with insurance and schedules inspections. For complex insurance questions, it can transfer to your team."
  },
  {
    question: "What happens during a storm when call volume spikes?",
    answer: "This is where AI shines. Unlike human receptionists who can only handle one call at a time, your AI employee handles unlimited simultaneous calls. Every caller gets immediate attention, even during the busiest storm response periods."
  },
  {
    question: "Can it schedule appointments for specific estimators or crews?",
    answer: "Absolutely. We can set up AI to book appointments based on territory, job type, or estimator availability. The AI respects your scheduling rules and keeps your calendar organized."
  },
  {
    question: "How does emergency call handling work?",
    answer: "You define what constitutes an emergency (active leaks, tarping needs, etc.). When AI identifies an emergency, it can immediately transfer to your emergency line, text your on-call person, or follow whatever escalation process you prefer."
  }
];

const iconPaths: Record<string, string> = {
  "cloud-lightning": "M13 10V3L4 14h7v7l9-11h-7z",
  "clipboard-check": "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
  "calendar": "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  "alert-triangle": "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
  "refresh": "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
  "star": "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
};

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AI Receptionist for Roofing Companies",
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "Creative Integrations"
  },
  "serviceType": "AI Business Automation",
  "areaServed": "United States",
  "audience": {
    "@type": "Audience",
    "audienceType": "Roofing Contractors"
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <!-- Hero -->
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
    
    <div class="relative container-width section-padding">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6">
          <span class="w-2 h-2 bg-accent-400 rounded-full"></span>
          For Roofing Contractors
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
          Never Miss a<br />
          <span class="text-gradient">Storm Damage Call</span> Again
        </h1>
        
        <p class="text-xl text-primary-200 mb-8">
          When storms hit, your phone explodes. AI Employees handle every call — qualifying leads, scheduling estimates, and dispatching emergency crews — while you focus on the work.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:877-482-4368" class="btn-primary text-lg px-8 py-4">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Hear Roofing AI Demo
          </a>
          <a href="/pricing" class="btn-secondary">
            View Pricing
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Problem Section -->
  <section class="section-padding bg-gradient-section">
    <div class="container-width">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
          The Roofing Lead Problem
        </h2>
        <p class="text-primary-600 text-lg">
          Storm season is feast or famine. When calls flood in, you miss leads. When it's slow, every call matters. Either way, missed calls mean missed revenue.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">85%</div>
          <p class="text-primary-600">of missed calls never call back — they call your competitor instead</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">$2,500+</div>
          <p class="text-primary-600">average value of a roofing job you lose with every missed call</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">24/7</div>
          <p class="text-primary-600">storm damage doesn't wait for business hours — neither should you</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Benefits -->
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
          How AI Employees Help Roofing Contractors
        </h2>
        <p class="text-primary-600 text-lg max-w-2xl mx-auto">
          Purpose-built for the roofing industry. Trained on your services, your process, and your market.
        </p>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="card p-6 group hover:border-accent-300">
            <div class="w-12 h-12 mb-4 bg-primary-100 rounded-xl flex items-center justify-center group-hover:bg-accent-500 transition-colors duration-300">
              <svg 
                class="w-6 h-6 text-primary-700 group-hover:text-white transition-colors duration-300" 
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[benefit.icon]} />
              </svg>
            </div>
            
            <h3 class="font-display font-semibold text-primary-950 text-lg mb-2">
              {benefit.title}
            </h3>
            
            <p class="text-primary-600 text-sm leading-relaxed">
              {benefit.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- FAQ -->
  <FAQSection 
    title="Roofing AI Questions"
    faqs={faqs}
  />
  
  <CTASection 
    headline="Ready to Capture Every Roofing Lead?"
    subheadline="Stop losing jobs to missed calls. Let AI handle your phones 24/7."
  />
</BaseLayout>
