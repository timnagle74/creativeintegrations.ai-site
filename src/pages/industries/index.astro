---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "Industries We Serve";
const pageDescription = "AI Employees customized for your industry. From enterprise call centers to roofing contractors — we train our AI on your specific business needs.";

const industries = [
  {
    name: "Enterprise Call Centers",
    slug: "call-centers",
    description: "Scale your call center with AI that handles thousands of concurrent calls. 80%+ resolution rate, 48-hour deployment.",
    image: "https://images.unsplash.com/photo-1573496799652-408c2ac9fe98?w=800&q=80",
    benefits: ["Massive concurrency", "Enterprise integrations", "Real-time analytics"],
    featured: true
  },
  {
    name: "Roofing",
    slug: "roofing",
    description: "Never miss a storm damage call. AI handles estimates, scheduling, and emergency requests 24/7.",
    image: "https://images.unsplash.com/photo-1635424710928-0544e8512eae?w=800&q=80",
    benefits: ["Storm damage response", "Estimate scheduling", "Emergency dispatch"]
  },
  {
    name: "HVAC",
    slug: "hvac",
    description: "Capture every AC emergency and heating call. Book service appointments automatically.",
    image: "https://images.pexels.com/photos/5463577/pexels-photo-5463577.jpeg?auto=compress&cs=tinysrgb&w=800",
    benefits: ["Emergency service calls", "Maintenance scheduling", "Quote requests"]
  },
  {
    name: "Plumbing",
    slug: "plumbing",
    description: "Emergency plumbing calls at 2 AM? Your AI employee handles it while you sleep.",
    image: "https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=800&q=80",
    benefits: ["24/7 emergency response", "Service scheduling", "Quote generation"]
  },
  {
    name: "Equine Transport",
    slug: "equine-transport",
    description: "Coordinate horse transport logistics, quotes, and scheduling with intelligent AI assistance.",
    image: "https://images.unsplash.com/photo-1598974357801-cbca100e65d3?w=800&q=80",
    benefits: ["Transport coordination", "Quote requests", "Scheduling logistics"]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="absolute top-0 left-1/3 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
    
    <div class="relative container-width section-padding text-center">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
        AI Employees for<br />
        <span class="text-gradient">Your Industry</span>
      </h1>
      <p class="text-xl text-primary-200 max-w-2xl mx-auto">
        Custom-trained AI that understands your business, your services, and your customers. From enterprise call centers to local contractors — built specifically for you.
      </p>
    </div>
  </section>

  <!-- Featured: Call Centers -->
  {industries.filter(i => i.featured).map((industry) => (
    <section class="section-padding bg-primary-900">
      <div class="container-width">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-accent-500/20 rounded-full text-accent-300 text-sm font-medium mb-6">
              <span class="w-2 h-2 bg-accent-400 rounded-full animate-pulse"></span>
              Enterprise Solution
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
              {industry.name}
            </h2>
            <p class="text-xl text-primary-200 mb-6">{industry.description}</p>
            <div class="flex flex-wrap gap-2 mb-8">
              {industry.benefits.map((benefit) => (
                <span class="px-4 py-2 bg-white/10 text-white text-sm rounded-full">
                  {benefit}
                </span>
              ))}
            </div>
            <a href={`/industries/${industry.slug}`} class="btn-primary">
              Learn About Enterprise
            </a>
          </div>
          <div class="relative">
            <img 
              src={industry.image} 
              alt={industry.name}
              class="rounded-2xl shadow-2xl w-full aspect-video object-cover"
            />
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-t from-primary-900/60 to-transparent"></div>
          </div>
        </div>
      </div>
    </section>
  ))}
  
  <!-- Industries Grid -->
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-primary-900 mb-4">
          Service Business Solutions
        </h2>
        <p class="text-xl text-primary-600 max-w-2xl mx-auto">
          AI Employees trained for specific industries. Your business, your workflows, your customers.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        {industries.filter(i => !i.featured).map((industry) => (
          <a 
            href={`/industries/${industry.slug}`}
            class="card overflow-hidden group hover:shadow-xl transition-all duration-300"
          >
            <div class="aspect-video relative overflow-hidden">
              <img 
                src={industry.image} 
                alt={industry.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary-900/80 via-primary-900/20 to-transparent"></div>
              <h3 class="absolute bottom-4 left-4 font-display font-bold text-white text-2xl">{industry.name}</h3>
            </div>
            <div class="p-6">
              <p class="text-primary-600 mb-4">{industry.description}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {industry.benefits.map((benefit) => (
                  <span class="px-3 py-1 bg-accent-100 text-accent-700 text-sm rounded-full">
                    {benefit}
                  </span>
                ))}
              </div>
              <span class="inline-flex items-center text-accent-600 font-medium group-hover:gap-2 transition-all">
                Learn more
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
      
      <div class="mt-12 text-center">
        <div class="card-dark inline-block p-8 max-w-xl">
          <h3 class="font-display font-bold text-white text-xl mb-3">Don't see your industry?</h3>
          <p class="text-primary-300 mb-4">We customize AI Employees for any service business. Let's talk about your specific needs.</p>
          <a href="/contact" class="btn-primary">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <CTASection />
</BaseLayout>
