---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "AI Receptionist for Equine Transport Companies";
const pageDescription = "Coordinate horse transport logistics with AI. Handle quote requests, scheduling, and customer inquiries 24/7 for equine transportation businesses.";

const benefits = [
  {
    title: "24/7 Quote Requests",
    description: "Horse owners call when they need to — not just during business hours. AI captures every inquiry with pickup/delivery locations, dates, and horse details.",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
  },
  {
    title: "Route & Schedule Coordination",
    description: "AI gathers all the details needed to plan efficient routes — locations, timing flexibility, special requirements, and number of horses.",
    icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
  },
  {
    title: "Emergency Transport Handling",
    description: "Vet emergencies, last-minute show transport, urgent relocations — AI identifies time-sensitive requests and escalates appropriately.",
    icon: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
  },
  {
    title: "Customer Updates",
    description: "AI can send automated updates on transport status, estimated arrival times, and schedule confirmations via text or email.",
    icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
  },
  {
    title: "Special Requirements Capture",
    description: "AI gathers health certificates, Coggins requirements, special handling needs, and any accommodations needed for the horses.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  },
  {
    title: "Review & Reputation Building",
    description: "After successful transports, AI requests reviews from satisfied customers. Build trust in a relationship-driven industry.",
    icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
  }
];

const faqs = [
  {
    question: "Can AI handle the specific details needed for horse transport quotes?",
    answer: "Yes. We train your AI to gather all relevant details: pickup and delivery locations, number of horses, dates/flexibility, special requirements (stallions, mares in foal, etc.), health documentation status, and any layover needs."
  },
  {
    question: "How does AI handle urgent or emergency transport requests?",
    answer: "You define what constitutes urgent (vet emergencies, time-sensitive show transport, etc.). AI identifies these through smart questioning and can immediately notify you via text, transfer the call, or follow your escalation process."
  },
  {
    question: "Can it explain your routes and service areas?",
    answer: "Absolutely. AI is trained on your regular routes, service areas, and typical schedules. It can explain your coverage and capture requests for areas you serve."
  },
  {
    question: "What about health certificate and Coggins questions?",
    answer: "AI can explain your requirements, remind customers what documentation is needed, and note the status of their paperwork. It ensures you have all compliance details before transport."
  },
  {
    question: "How does scheduling work for multi-stop routes?",
    answer: "AI gathers timing preferences and flexibility for each inquiry. You receive all the details to plan efficient routes, and AI can communicate schedules back to customers."
  },
  {
    question: "Can AI handle boarding or layover inquiries?",
    answer: "Yes. If you offer layover services or partner with facilities, AI can explain options, gather requirements, and include this in the quote request."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AI Receptionist for Equine Transport",
  "description": pageDescription,
  "provider": { "@type": "Organization", "name": "Creative Integrations" },
  "serviceType": "AI Business Automation",
  "areaServed": "United States",
  "audience": { "@type": "Audience", "audienceType": "Equine Transport Companies" }
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <!-- Hero -->
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
    
    <div class="relative container-width section-padding">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6">
          <span class="w-2 h-2 bg-accent-400 rounded-full"></span>
          For Equine Transport
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
          Coordinate Transport<br />
          <span class="text-gradient">Around the Clock</span>
        </h1>
        
        <p class="text-xl text-primary-200 mb-8">
          Horse owners need transport at all hours — show schedules, vet emergencies, farm moves. Your AI employee captures every inquiry, gathers all the details, and keeps your routes full.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:877-482-4368" class="btn-primary text-lg px-8 py-4">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Hear AI Demo
          </a>
          <a href="/pricing" class="btn-secondary">
            View Pricing
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Problem Section -->
  <section class="section-padding bg-gradient-section">
    <div class="container-width">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
          The Equine Transport Challenge
        </h2>
        <p class="text-primary-600 text-lg">
          You're on the road, managing horses, coordinating logistics — and missing calls means missing bookings. In a relationship-driven industry, every missed connection matters.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">85%</div>
          <p class="text-primary-600">of callers won't leave voicemail — they'll call another hauler</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">$500+</div>
          <p class="text-primary-600">average transport booking lost with each missed inquiry</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">24/7</div>
          <p class="text-primary-600">horse emergencies and show schedules don't follow business hours</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Benefits -->
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
          How AI Employees Help Equine Transporters
        </h2>
        <p class="text-primary-600 text-lg max-w-2xl mx-auto">
          Built for the unique needs of horse hauling. Trained on your routes, your services, and your requirements.
        </p>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="card p-6 group hover:border-accent-300">
            <div class="w-12 h-12 mb-4 bg-primary-100 rounded-xl flex items-center justify-center group-hover:bg-accent-500 transition-colors duration-300">
              <svg class="w-6 h-6 text-primary-700 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={benefit.icon} />
              </svg>
            </div>
            <h3 class="font-display font-semibold text-primary-950 text-lg mb-2">{benefit.title}</h3>
            <p class="text-primary-600 text-sm leading-relaxed">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Trust Section -->
  <section class="section-padding bg-gradient-section">
    <div class="container-width">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-3xl font-bold text-primary-950 mb-4">
          Built for a Relationship Business
        </h2>
        <p class="text-primary-600 text-lg mb-8">
          We understand that equine transport is built on trust. Your AI is trained to be professional, knowledgeable, and reassuring — representing your business exactly how you would.
        </p>
        <div class="grid sm:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-3 bg-accent-100 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold text-primary-950">Professional</h3>
            <p class="text-primary-600 text-sm">Represents your business with care</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-3 bg-accent-100 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="font-display font-semibold text-primary-950">Knowledgeable</h3>
            <p class="text-primary-600 text-sm">Trained on equine transport specifics</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-3 bg-accent-100 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold text-primary-950">Reassuring</h3>
            <p class="text-primary-600 text-sm">Puts anxious horse owners at ease</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <FAQSection title="Equine Transport AI Questions" faqs={faqs} />
  <CTASection headline="Ready to Fill Your Routes?" subheadline="Stop missing bookings while you're on the road. Let AI handle inquiries 24/7." />
</BaseLayout>
