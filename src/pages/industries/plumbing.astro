---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "AI Receptionist for Plumbing Companies";
const pageDescription = "Never miss an emergency plumbing call again. AI Employees handle burst pipes at 2 AM, schedule service appointments, and qualify leads 24/7 for plumbers.";

const benefits = [
  {
    title: "24/7 Emergency Response",
    description: "Burst pipes don't wait for business hours. Your AI handles every emergency call instantly — 2 AM, weekends, holidays.",
    icon: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
  },
  {
    title: "Instant Lead Qualification",
    description: "AI gathers problem details, property info, and urgency level before you call back. Arrive prepared for every job.",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
  },
  {
    title: "Service Scheduling",
    description: "AI books appointments directly on your calendar based on job type, location, and technician availability.",
    icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
  },
  {
    title: "Emergency Dispatch",
    description: "True emergencies get flagged immediately. AI can transfer to your emergency line or text your on-call plumber.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  },
  {
    title: "Quote Follow-Ups",
    description: "Automated sequences re-engage customers who received quotes but haven't booked. Convert more estimates.",
    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
  },
  {
    title: "Review Generation",
    description: "Happy customers get review requests at the perfect moment. Build your reputation on autopilot.",
    icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
  }
];

const faqs = [
  {
    question: "How does AI handle true plumbing emergencies?",
    answer: "You define emergency criteria (burst pipes, sewage backup, gas smell, etc.). AI asks smart questions to identify emergencies, then immediately transfers to your emergency line, texts your on-call plumber, or follows your escalation process."
  },
  {
    question: "Can AI give quotes or estimates?",
    answer: "AI can provide typical price ranges for common services and explain your pricing structure. For accurate quotes, it gathers details and schedules an assessment or connects them with your team."
  },
  {
    question: "What information does AI collect from callers?",
    answer: "AI gathers property type, problem description, urgency level, any troubleshooting already attempted, contact info, and preferred scheduling times. You get all this before making a callback."
  },
  {
    question: "Can it handle commercial and residential differently?",
    answer: "Absolutely. We configure AI to route commercial calls appropriately, gather different information for commercial properties, and schedule with commercial-specific availability."
  },
  {
    question: "How does scheduling work with multiple plumbers?",
    answer: "AI respects your scheduling rules — technician territories, job type assignments, drive time buffers, and availability. It can also prioritize based on job urgency."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AI Receptionist for Plumbing Companies",
  "description": pageDescription,
  "provider": { "@type": "Organization", "name": "Creative Integrations" },
  "serviceType": "AI Business Automation",
  "areaServed": "United States",
  "audience": { "@type": "Audience", "audienceType": "Plumbing Contractors" }
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <!-- Hero -->
  <section class="relative overflow-hidden min-h-[500px]">
    <div class="absolute inset-0">
      <img 
        src="https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=1600&q=80" 
        alt="Professional plumber at work"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-900/95 via-primary-900/80 to-primary-900/60"></div>
    </div>
    <div class="absolute inset-0 grid-bg opacity-30"></div>
    
    <div class="relative container-width section-padding">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6">
          <span class="w-2 h-2 bg-accent-400 rounded-full"></span>
          For Plumbing Contractors
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
          Emergency Calls at 2 AM?<br />
          <span class="text-gradient">AI Handles It.</span>
        </h1>
        
        <p class="text-xl text-primary-200 mb-8">
          Burst pipes, clogged drains, water heater failures — plumbing emergencies don't wait. Your AI employee answers every call, qualifies every lead, and dispatches help when needed.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:877-482-4368" class="btn-primary text-lg px-8 py-4">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Hear Plumbing AI Demo
          </a>
          <a href="/pricing" class="btn-secondary">
            View Pricing
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Stats -->
  <section class="section-padding bg-gradient-section">
    <div class="container-width">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">85%</div>
          <p class="text-primary-600">of missed calls never call back — they're already calling your competitor</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">$350+</div>
          <p class="text-primary-600">average service call value lost with every missed opportunity</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">60%</div>
          <p class="text-primary-600">of plumbing emergencies happen outside business hours</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Benefits -->
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
          How AI Employees Help Plumbers
        </h2>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="card p-6 group hover:border-accent-300">
            <div class="w-12 h-12 mb-4 bg-primary-100 rounded-xl flex items-center justify-center group-hover:bg-accent-500 transition-colors duration-300">
              <svg class="w-6 h-6 text-primary-700 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={benefit.icon} />
              </svg>
            </div>
            <h3 class="font-display font-semibold text-primary-950 text-lg mb-2">{benefit.title}</h3>
            <p class="text-primary-600 text-sm leading-relaxed">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <FAQSection title="Plumbing AI Questions" faqs={faqs} />
  <CTASection headline="Ready to Capture Every Plumbing Call?" subheadline="Stop losing emergencies to voicemail. Let AI handle your phones 24/7." />
</BaseLayout>
