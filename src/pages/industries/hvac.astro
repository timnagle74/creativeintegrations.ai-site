---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "AI Receptionist for HVAC Companies";
const pageDescription = "Capture every AC emergency and heating call. AI Employees handle service scheduling, maintenance appointments, and emergency dispatch 24/7 for HVAC contractors.";

const benefits = [
  {
    title: "Never Miss an Emergency Call",
    description: "AC dies on the hottest day of summer? Furnace fails during a cold snap? Your AI handles every emergency call instantly, 24/7/365.",
    icon: "alert-circle"
  },
  {
    title: "Book Service Appointments",
    description: "AI schedules service calls directly on your calendar. Customers get confirmations and reminders automatically.",
    icon: "calendar"
  },
  {
    title: "Qualify Before Dispatch",
    description: "AI gathers equipment details, symptoms, and warranty info before you roll a truck. Show up prepared, save time.",
    icon: "clipboard"
  },
  {
    title: "Maintenance Plan Sign-Ups",
    description: "AI explains your maintenance programs and captures sign-ups. Grow recurring revenue while you're on a job site.",
    icon: "refresh"
  },
  {
    title: "After-Hours Coverage",
    description: "Weekend calls, holiday emergencies, 2 AM breakdowns — AI handles them all so you can actually rest.",
    icon: "moon"
  },
  {
    title: "Review Collection",
    description: "After every completed job, AI requests reviews at the perfect moment. Build your reputation automatically.",
    icon: "star"
  }
];

const faqs = [
  {
    question: "Can the AI answer technical questions about HVAC systems?",
    answer: "We train your AI on common HVAC questions — typical issues, basic troubleshooting, and when professional service is needed. It won't diagnose complex problems, but it handles the questions that don't require a technician."
  },
  {
    question: "How does emergency prioritization work?",
    answer: "You define what counts as an emergency (no heat in winter, no AC in summer, gas smell, etc.). AI identifies emergencies through smart questioning and can immediately transfer to your emergency line, text your on-call tech, or follow your escalation process."
  },
  {
    question: "Can it schedule based on technician availability and territory?",
    answer: "Yes. We configure AI to respect your scheduling rules — technician territories, job type assignments, drive time buffers, and availability windows. Your calendar stays organized."
  },
  {
    question: "What about warranty and parts questions?",
    answer: "AI can gather warranty information, explain your warranty process, and note equipment details. For specific warranty claims, it can transfer to your team or schedule a callback."
  },
  {
    question: "How does it handle calls about estimates for new systems?",
    answer: "AI qualifies leads for new installations by gathering home details, current equipment info, and timeline. It schedules in-home consultations and sends you all the details before the appointment."
  }
];

const iconPaths: Record<string, string> = {
  "alert-circle": "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  "calendar": "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  "clipboard": "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2",
  "refresh": "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
  "moon": "M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z",
  "star": "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
};

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AI Receptionist for HVAC Companies",
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "Creative Integrations"
  },
  "serviceType": "AI Business Automation",
  "areaServed": "United States",
  "audience": {
    "@type": "Audience",
    "audienceType": "HVAC Contractors"
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <!-- Hero -->
  <section class="relative overflow-hidden min-h-[500px]">
    <div class="absolute inset-0">
      <img 
        src="https://images.pexels.com/photos/5463577/pexels-photo-5463577.jpeg?auto=compress&cs=tinysrgb&w=1600" 
        alt="HVAC technician working"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-900/95 via-primary-900/80 to-primary-900/60"></div>
    </div>
    <div class="absolute inset-0 grid-bg opacity-30"></div>
    
    <div class="relative container-width section-padding">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6">
          <span class="w-2 h-2 bg-accent-400 rounded-full"></span>
          For HVAC Contractors
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
          Capture Every<br />
          <span class="text-gradient">HVAC Emergency</span>
        </h1>
        
        <p class="text-xl text-primary-200 mb-8">
          When the AC dies on the hottest day of summer, customers call everyone until someone answers. Make sure that someone is you — with AI that never misses a call.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:877-482-4368" class="btn-primary text-lg px-8 py-4">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Hear HVAC AI Demo
          </a>
          <a href="/pricing" class="btn-secondary">
            View Pricing
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Problem Section -->
  <section class="section-padding bg-gradient-section">
    <div class="container-width">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
          HVAC is a Speed Game
        </h2>
        <p class="text-primary-600 text-lg">
          Comfort emergencies don't wait. When customers are too hot or too cold, they call until someone answers. The first company to pick up usually wins the job.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">67%</div>
          <p class="text-primary-600">of callers hang up if they don't get immediate assistance</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">$500+</div>
          <p class="text-primary-600">average service call value — multiplied by every missed opportunity</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">24/7</div>
          <p class="text-primary-600">HVAC emergencies happen at 2 AM, on weekends, and holidays</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Benefits -->
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
          How AI Employees Help HVAC Contractors
        </h2>
        <p class="text-primary-600 text-lg max-w-2xl mx-auto">
          Built for the heating and cooling industry. Trained on your services, your territory, and your scheduling needs.
        </p>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="card p-6 group hover:border-accent-300">
            <div class="w-12 h-12 mb-4 bg-primary-100 rounded-xl flex items-center justify-center group-hover:bg-accent-500 transition-colors duration-300">
              <svg 
                class="w-6 h-6 text-primary-700 group-hover:text-white transition-colors duration-300" 
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[benefit.icon]} />
              </svg>
            </div>
            
            <h3 class="font-display font-semibold text-primary-950 text-lg mb-2">
              {benefit.title}
            </h3>
            
            <p class="text-primary-600 text-sm leading-relaxed">
              {benefit.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- FAQ -->
  <FAQSection 
    title="HVAC AI Questions"
    faqs={faqs}
  />
  
  <CTASection 
    headline="Ready to Capture Every HVAC Call?"
    subheadline="Stop losing emergencies to voicemail. Let AI handle your phones 24/7."
  />
</BaseLayout>
