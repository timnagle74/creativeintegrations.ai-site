---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

const pageTitle = "About Creative Integrations";
const pageDescription = "Learn about Creative Integrations and our mission to help local businesses thrive with AI-powered automation. Based in Texas, serving businesses nationwide.";

const values = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: "Speed to Lead",
    description: "We believe every missed call is a missed opportunity. Our AI responds instantly, 24/7, because your customers shouldn't have to wait."
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    title: "Reliability First",
    description: "Your business never sleeps, and neither do we. Our AI employees show up every day, every hour, without fail."
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    title: "Real ROI",
    description: "We're not about flashy tech for tech's sake. Every feature we build is designed to put more money in your pocket."
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    title: "Partner Mindset",
    description: "We succeed when you succeed. That's why we offer hands-on setup, ongoing optimization, and support that actually helps."
  }
];

const stats = [
  { value: "500+", label: "Businesses Served" },
  { value: "1M+", label: "Calls Handled" },
  { value: "24/7", label: "Availability" },
  { value: "< 1s", label: "Response Time" }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-primary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
          We Help Local Businesses <span class="text-accent-600">Never Miss Another Opportunity</span>
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
          Creative Integrations builds AI employees that answer calls, qualify leads, and book appointments 24/7 — so you can focus on what you do best.
        </p>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="py-12 bg-white border-y border-gray-100">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-accent-600 mb-2">{stat.value}</div>
            <div class="text-sm text-gray-600">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <span class="inline-block px-4 py-1 bg-accent-100 text-accent-700 rounded-full text-sm font-medium mb-4">
              Our Story
            </span>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
              Built by Business Owners, for Business Owners
            </h2>
            <div class="space-y-4 text-gray-600">
              <p>
                Creative Integrations was born from a simple frustration: watching great local businesses lose customers because they couldn't answer every call.
              </p>
              <p>
                We saw roofers miss leads while on the roof. HVAC techs lose jobs while fixing units. Plumbers watch opportunities drain away while they were knee-deep in a repair.
              </p>
              <p>
                Traditional answering services were expensive and inconsistent. Voicemail was a black hole. And hiring a full-time receptionist? Not realistic for most small businesses.
              </p>
              <p>
                So we built something better: AI employees that cost less than a part-time hire but work harder than a full team. They never call in sick, never have a bad day, and never miss a call.
              </p>
            </div>
          </div>
          <div class="bg-gradient-to-br from-accent-500 to-accent-700 rounded-2xl p-8 text-white">
            <h3 class="text-2xl font-bold mb-4">Our Mission</h3>
            <p class="text-lg text-white/90 mb-6">
              To give every local business the same competitive advantage that big corporations have — instant, professional customer response — at a price that makes sense.
            </p>
            <div class="border-t border-white/20 pt-6">
              <p class="text-white/80 text-sm">
                Based in Texas. Serving businesses nationwide.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Values -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-1 bg-accent-100 text-accent-700 rounded-full text-sm font-medium mb-4">
            Our Values
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            What We Stand For
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            These principles guide everything we build and every business we serve.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {values.map((value) => (
            <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
              <div class="w-14 h-14 bg-accent-100 rounded-xl flex items-center justify-center text-accent-600 mb-4">
                <Fragment set:html={value.icon} />
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">{value.title}</h3>
              <p class="text-gray-600">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why AI Section -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-1 bg-accent-100 text-accent-700 rounded-full text-sm font-medium mb-4">
            Why AI?
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            The Future of Customer Service is Here
          </h2>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
          <div class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-200">
            <div class="p-8 text-center">
              <div class="text-4xl font-bold text-red-500 mb-2">67%</div>
              <p class="text-gray-600">of customers hang up if they don't get immediate assistance</p>
            </div>
            <div class="p-8 text-center">
              <div class="text-4xl font-bold text-red-500 mb-2">85%</div>
              <p class="text-gray-600">of missed calls never call back</p>
            </div>
            <div class="p-8 text-center">
              <div class="text-4xl font-bold text-green-500 mb-2">$1,200</div>
              <p class="text-gray-600">average value of each converted lead for service businesses</p>
            </div>
          </div>
        </div>

        <div class="mt-12 text-center">
          <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
            AI isn't replacing your team — it's giving them superpowers. Handle more calls, qualify better leads, and book more appointments without hiring more staff.
          </p>
          <a href="/features" class="btn-primary">
            See How It Works
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries We Serve -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-1 bg-accent-100 text-accent-700 rounded-full text-sm font-medium mb-4">
          Who We Serve
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Built for Local Service Businesses
        </h2>
        <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
          Our AI employees are specially trained to handle the unique needs of service-based businesses.
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <a href="/industries/roofing" class="px-6 py-3 bg-white border border-gray-200 rounded-full text-gray-700 hover:border-accent-300 hover:text-accent-600 transition-colors">
            Roofing
          </a>
          <a href="/industries/hvac" class="px-6 py-3 bg-white border border-gray-200 rounded-full text-gray-700 hover:border-accent-300 hover:text-accent-600 transition-colors">
            HVAC
          </a>
          <a href="/industries/plumbing" class="px-6 py-3 bg-white border border-gray-200 rounded-full text-gray-700 hover:border-accent-300 hover:text-accent-600 transition-colors">
            Plumbing
          </a>
          <a href="/industries/equine-transport" class="px-6 py-3 bg-white border border-gray-200 rounded-full text-gray-700 hover:border-accent-300 hover:text-accent-600 transition-colors">
            Equine Transport
          </a>
          <span class="px-6 py-3 bg-white border border-gray-200 rounded-full text-gray-700">
            Electrical
          </span>
          <span class="px-6 py-3 bg-white border border-gray-200 rounded-full text-gray-700">
            Landscaping
          </span>
          <span class="px-6 py-3 bg-white border border-gray-200 rounded-full text-gray-700">
            Pest Control
          </span>
          <span class="px-6 py-3 bg-white border border-gray-200 rounded-full text-gray-700">
            Auto Services
          </span>
        </div>

        <p class="mt-8 text-gray-500">
          Don't see your industry? <a href="/contact" class="text-accent-600 hover:underline">Contact us</a> — we customize AI employees for any service business.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Info -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white rounded-2xl border border-gray-200 p-8">
            <h3 class="text-xl font-bold text-gray-900 mb-6">Get in Touch</h3>
            <div class="space-y-4">
              <a href="tel:469-249-8057" class="flex items-center gap-3 text-gray-600 hover:text-accent-600 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>(469) 249-8057</span>
              </a>
              <a href="mailto:hello@creativeintegrations.ai" class="flex items-center gap-3 text-gray-600 hover:text-accent-600 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>hello@creativeintegrations.ai</span>
              </a>
              <div class="flex items-start gap-3 text-gray-600">
                <svg class="w-5 h-5 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>Based in Texas<br />Serving businesses nationwide</span>
              </div>
            </div>
          </div>

          <div class="bg-accent-600 rounded-2xl p-8 text-white">
            <h3 class="text-xl font-bold mb-4">Try Our AI Demo</h3>
            <p class="text-white/90 mb-6">
              Want to experience our AI employee firsthand? Give us a call and see how it handles your inquiry.
            </p>
            <a
              href="tel:877-482-4368"
              class="inline-flex items-center gap-2 bg-white text-accent-600 font-semibold px-6 py-3 rounded-lg hover:bg-white/90 transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call (877) 482-4368
            </a>
            <p class="text-white/70 text-sm mt-4">
              Available 24/7 — that's the whole point.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
