---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Contact Us";
const pageDescription = "Get in touch with Creative Integrations. Talk to our AI demo, schedule a strategy call, or reach out with questions about AI employees for your business.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
    
    <div class="relative container-width section-padding text-center">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
        Let's <span class="text-gradient">Talk</span>
      </h1>
      <p class="text-xl text-primary-200 max-w-2xl mx-auto">
        Ready to see how AI employees can transform your business? Try our demo, schedule a call, or send us a message.
      </p>
    </div>
  </section>
  
  <!-- Contact Options -->
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="grid lg:grid-cols-3 gap-8 mb-16">
        <!-- Try AI Demo -->
        <div class="card p-8 text-center group hover:border-accent-300 hover:shadow-lg transition-all">
          <div class="w-16 h-16 mx-auto mb-6 bg-accent-100 rounded-2xl flex items-center justify-center group-hover:bg-accent-500 transition-colors">
            <svg class="w-8 h-8 text-accent-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
            </svg>
          </div>
          <h2 class="font-display font-bold text-primary-950 text-xl mb-3">Try AI Demo</h2>
          <p class="text-primary-600 mb-6">
            Experience our AI voice employee yourself. Call now and have a real conversation.
          </p>
          <a 
            href="tel:877-482-4368"
            class="inline-flex items-center justify-center gap-2 w-full py-4 bg-accent-600 text-white font-semibold rounded-xl hover:bg-accent-700 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            877-482-4368
          </a>
        </div>
        
        <!-- Schedule Strategy Call -->
        <div class="card p-8 text-center group hover:border-accent-300 hover:shadow-lg transition-all">
          <div class="w-16 h-16 mx-auto mb-6 bg-primary-100 rounded-2xl flex items-center justify-center group-hover:bg-primary-900 transition-colors">
            <svg class="w-8 h-8 text-primary-700 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="font-display font-bold text-primary-950 text-xl mb-3">Schedule a Call</h2>
          <p class="text-primary-600 mb-6">
            Book a free strategy session. We'll discuss your needs and show you exactly how AI can help.
          </p>
          <a 
            href="#schedule"
            class="inline-flex items-center justify-center gap-2 w-full py-4 bg-primary-950 text-white font-semibold rounded-xl hover:bg-primary-800 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Book Strategy Call
          </a>
        </div>
        
        <!-- Talk to Sales -->
        <div class="card p-8 text-center group hover:border-accent-300 hover:shadow-lg transition-all">
          <div class="w-16 h-16 mx-auto mb-6 bg-primary-100 rounded-2xl flex items-center justify-center group-hover:bg-primary-900 transition-colors">
            <svg class="w-8 h-8 text-primary-700 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
            </svg>
          </div>
          <h2 class="font-display font-bold text-primary-950 text-xl mb-3">Talk to Sales</h2>
          <p class="text-primary-600 mb-6">
            Have questions? Call us directly. We're happy to answer any questions about our services.
          </p>
          <a 
            href="tel:469-249-8057"
            class="inline-flex items-center justify-center gap-2 w-full py-4 bg-white border-2 border-primary-200 text-primary-900 font-semibold rounded-xl hover:border-primary-400 hover:bg-primary-50 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            469-249-8057
          </a>
        </div>
      </div>
      
      <!-- Contact Form -->
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="font-display text-3xl font-bold text-primary-950 mb-4">Send Us a Message</h2>
          <p class="text-primary-600">
            Fill out the form below and we'll get back to you within 24 hours.
          </p>
        </div>
        
        <!-- GHL Form Embed -->
        <div class="card p-2 overflow-hidden" style="min-height: 1050px;">
          <iframe
            src="https://updates.creativeintegrations.com/widget/form/5ua6U0PYMdk87cU1a4ge"
            style="width:100%;height:1006px;border:none;border-radius:3px"
            id="inline-5ua6U0PYMdk87cU1a4ge" 
            data-layout="{'id':'INLINE'}"
            data-trigger-type="alwaysShow"
            data-trigger-value=""
            data-activation-type="alwaysActivated"
            data-activation-value=""
            data-deactivation-type="neverDeactivate"
            data-deactivation-value=""
            data-form-name="1b. AI Chat Demo Request"
            data-height="1006"
            data-layout-iframe-id="inline-5ua6U0PYMdk87cU1a4ge"
            data-form-id="5ua6U0PYMdk87cU1a4ge"
            title="AI Chat Demo Request"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Calendar Booking Section -->
  <section id="schedule" class="section-padding bg-gradient-section">
    <div class="container-width">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="font-display text-3xl font-bold text-primary-950 mb-4">Book a Strategy Call</h2>
          <p class="text-primary-600">
            Pick a time that works for you. We'll discuss your business, your goals, and how AI employees can help.
          </p>
        </div>
        
        <div class="card p-4 overflow-hidden">
          <iframe 
            src="https://updates.creativeintegrations.com/widget/booking/3lQs0LfGz6gdQVCm4gm1" 
            style="width: 100%; min-height: 700px; border: none; overflow: hidden;" 
            scrolling="no" 
            id="3lQs0LfGz6gdQVCm4gm1_booking"
            title="Book a Strategy Call"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script src="https://updates.creativeintegrations.com/js/form_embed.js"></script>
