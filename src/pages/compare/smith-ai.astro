---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "Creative Integrations vs Smith.ai";
const pageDescription = "Compare Creative Integrations AI employees with Smith.ai live receptionists. See why AI-powered automation delivers better ROI for local businesses.";

const comparisonData = [
  {
    feature: "24/7 Availability",
    us: "Always on, no holidays or sick days",
    them: "Limited hours, extra fees for after-hours",
    winner: "us"
  },
  {
    feature: "Response Time",
    us: "Instant - answers in under 1 second",
    them: "May have hold times during peak hours",
    winner: "us"
  },
  {
    feature: "Cost Per Call",
    us: "Flat monthly rate, unlimited calls",
    them: "$2.50-$4.00+ per call/chat",
    winner: "us"
  },
  {
    feature: "Scalability",
    us: "Handle unlimited simultaneous calls",
    them: "Limited by available staff",
    winner: "us"
  },
  {
    feature: "Consistency",
    us: "Same perfect experience every time",
    them: "Varies by receptionist",
    winner: "us"
  },
  {
    feature: "CRM Integration",
    us: "Native integration, auto-updates contacts",
    them: "Basic integrations via Zapier",
    winner: "us"
  },
  {
    feature: "Appointment Booking",
    us: "Instant booking with real-time availability",
    them: "Manual booking, potential delays",
    winner: "us"
  },
  {
    feature: "SMS/Text Capabilities",
    us: "Full two-way texting included",
    them: "Limited or additional cost",
    winner: "us"
  },
  {
    feature: "Human Escalation",
    us: "Smart transfer to your team when needed",
    them: "Always human (that's their model)",
    winner: "tie"
  },
  {
    feature: "Setup Time",
    us: "Live in 24-48 hours",
    them: "1-2 weeks onboarding",
    winner: "us"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-primary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-1 bg-accent-100 text-accent-700 rounded-full text-sm font-medium mb-6">
          Comparison
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
          Creative Integrations vs <span class="text-accent-600">Smith.ai</span>
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
          See why local businesses are switching from expensive live answering services to AI-powered employees that work 24/7 at a fraction of the cost.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/pricing" class="btn-primary">
            View Our Pricing
          </a>
          <a href="tel:877-482-4368" class="btn-secondary">
            Try Our AI Demo
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="py-12 bg-white border-b border-gray-100">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-accent-600 mb-2">70%</div>
          <div class="text-sm text-gray-600">Cost Savings vs Smith.ai</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-accent-600 mb-2">24/7</div>
          <div class="text-sm text-gray-600">Availability</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-accent-600 mb-2">&lt;1s</div>
          <div class="text-sm text-gray-600">Response Time</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-accent-600 mb-2">∞</div>
          <div class="text-sm text-gray-600">Simultaneous Calls</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12">
          Feature-by-Feature Comparison
        </h2>

        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b-2 border-gray-200">
                <th class="text-left py-4 px-4 font-semibold text-gray-900">Feature</th>
                <th class="text-left py-4 px-4 font-semibold text-accent-600 bg-accent-50 rounded-t-lg">Creative Integrations</th>
                <th class="text-left py-4 px-4 font-semibold text-gray-600">Smith.ai</th>
              </tr>
            </thead>
            <tbody>
              {comparisonData.map((row, index) => (
                <tr class={`border-b border-gray-100 ${index % 2 === 0 ? 'bg-gray-50' : ''}`}>
                  <td class="py-4 px-4 font-medium text-gray-900">{row.feature}</td>
                  <td class="py-4 px-4 bg-accent-50/50">
                    <div class="flex items-start gap-2">
                      {row.winner === 'us' && (
                        <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                      )}
                      <span class="text-gray-700">{row.us}</span>
                    </div>
                  </td>
                  <td class="py-4 px-4 text-gray-600">{row.them}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Comparison -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12">
          Real Cost Comparison
        </h2>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Smith.ai -->
          <div class="bg-white rounded-2xl p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Smith.ai</h3>
            <div class="text-3xl font-bold text-gray-600 mb-2">$292.50+</div>
            <div class="text-sm text-gray-500 mb-6">per month (30 calls)</div>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>$9.75 per additional call</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>After-hours costs extra</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>100 calls = $680+/month</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>Costs scale with volume</span>
              </li>
            </ul>
          </div>

          <!-- Creative Integrations -->
          <div class="bg-accent-600 rounded-2xl p-8 text-white relative overflow-hidden">
            <div class="absolute top-4 right-4 bg-white/20 px-3 py-1 rounded-full text-sm font-medium">
              Best Value
            </div>
            <h3 class="text-xl font-bold mb-4">Creative Integrations</h3>
            <div class="text-3xl font-bold mb-2">$397</div>
            <div class="text-sm text-white/80 mb-6">per month (unlimited)</div>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-300 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Unlimited calls included</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-300 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>24/7 coverage at no extra cost</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-300 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Same price at any volume</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-300 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>SMS, chat, and voice included</span>
              </li>
            </ul>
          </div>
        </div>

        <p class="text-center text-gray-500 mt-8 text-sm">
          * Smith.ai pricing based on publicly available information as of 2025. Prices may vary.
        </p>
      </div>
    </div>
  </section>

  <!-- When to Choose Section -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12">
          When to Choose Each Option
        </h2>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-gray-50 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Choose Smith.ai if you:</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-2">
                <span class="text-gray-400">•</span>
                <span>Need complex legal intake that requires human judgment</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-400">•</span>
                <span>Have very low call volume (&lt;20 calls/month)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-400">•</span>
                <span>Prefer human touch over efficiency</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gray-400">•</span>
                <span>Have budget for premium per-call pricing</span>
              </li>
            </ul>
          </div>

          <div class="bg-accent-50 rounded-2xl p-8 border-2 border-accent-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Choose Creative Integrations if you:</h3>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-accent-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Want predictable monthly costs</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-accent-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Need true 24/7 coverage without extra fees</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-accent-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Value speed and consistency</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-accent-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Want integrated SMS, chat, and voice</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-accent-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Need to scale without increasing costs</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
