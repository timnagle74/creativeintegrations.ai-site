---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

const pageTitle = "Features";
const pageDescription = "Discover all the AI-powered features that help your business capture more leads, book more appointments, and provide 24/7 customer service.";

