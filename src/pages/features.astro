      {
        title: "Natural Voice Conversations",
        description: "Advanced AI engages callers in natural, human-like conversations. No robotic responses — your customers get a real conversational experience.",
        icon: "microphone"
      },
      {
        title: "Custom Working Hours",
        description: "Choose when your AI employee responds. After hours, weekends, or 24/7 — you're in control.",
        icon: "clock"
      },
      {
        title: "Live Call Transfers",
        description: "AI can transfer calls to any number when needed. Complex issues go straight to your team.",
        icon: "phone-forward"
      },
      {
        title: "Information Gathering",
        description: "Collect contact info, service needs, budget, and any custom questions before connecting with your team.",
        icon: "clipboard"
      },
      {
        title: "Email Summaries",
        description: "Get transcripts and summaries of every call delivered to your inbox automatically.",
        icon: "mail"
      },
      {
        title: "Custom Voice & Tone",
        description: "Choose from multiple voices and customize the personality to match your brand.",
        icon: "settings"
      }
    ]
  },
  {
    title: "AI Chat Employee",
    description: "Instant engagement across every text-based channel",
    features: [
      {
        title: "SMS Conversations",
        description: "Respond to text messages instantly with intelligent, contextual responses that move leads through your funnel.",
        icon: "message"
      },
      {
        title: "Website Live Chat",
        description: "Engage visitors the moment they land. Answer questions, capture info, and guide buying decisions.",
        icon: "chat"
      },
      {
        title: "Missed Call Text Back",
        description: "Every missed call gets an instant text. Convert hang-ups into conversations automatically.",
        icon: "phone-missed"
      },
      {
        title: "Meta & Social DMs",
        description: "Respond to Facebook, Instagram, and Messenger inquiries instantly. Turn social engagement into sales.",
        icon: "share"
      }
    ]
  },
  {
    title: "Reviews & Reputation",
    description: "Build trust and climb search rankings automatically",
    features: [
      {
        title: "Automated Review Requests",
        description: "Send perfectly-timed review requests to happy customers. Grow your 5-star reviews on autopilot.",
        icon: "star"
      },
      {
        title: "AI Review Responses",
        description: "Every review gets a thoughtful, personalized response. Good or bad — AI handles it professionally.",
        icon: "reply"
      },
      {
        title: "Reputation Monitoring",
        description: "Track your ratings across platforms. Get alerts when reviews come in.",
        icon: "eye"
      }
    ]
  },
  {
    title: "CRM & Automation",
    description: "Everything connected in one powerful platform",
    features: [
      {
        title: "AI-Powered CRM",
        description: "All your leads and customers in one place with intelligent tagging and follow-up suggestions.",
        icon: "database"
      },
      {
        title: "Appointment Booking",
        description: "AI schedules appointments directly on your calendar. Automated confirmations and reminders included.",
        icon: "calendar"
      },
      {
        title: "Workflow Automation",
        description: "Custom actions trigger automatically. Send booking links, service menus, follow-ups — all hands-free.",
        icon: "zap"
      },
      {
        title: "2-Way Communication",
        description: "Text, email, DM, WhatsApp — all from one unified inbox. Never miss a message.",
        icon: "inbox"
      },
      {
        title: "Mobile App",
        description: "Manage everything from your phone. Respond to leads, check appointments, view reports — anywhere.",
        icon: "smartphone"
      },
      {
        title: "Automated Newsletters",
        description: "Answer a few questions and AI crafts your monthly newsletter. Stay top-of-mind effortlessly.",
        icon: "newspaper"
      }
    ]
  }
];

