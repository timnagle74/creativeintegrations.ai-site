---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
    
    <div class="relative container-width section-padding text-center">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
        Powerful Features,<br />
        <span class="text-gradient">Simple to Use</span>
      </h1>
      <p class="text-xl text-primary-200 max-w-2xl mx-auto mb-8">
        Everything you need to capture more leads, book more appointments, and provide exceptional customer service — 24/7.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:877-482-4368" class="btn-primary text-lg px-8 py-4">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Try AI Voice Demo
        </a>
        <a href="/pricing" class="btn-secondary">
          View Pricing
        </a>
      </div>
    </div>
  </section>
  
  <!-- Feature Categories -->
  {featureCategories.map((category, catIndex) => (
    <section class={`section-padding ${catIndex % 2 === 0 ? 'bg-white' : 'bg-gradient-section'}`}>
      <div class="container-width">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
            {category.title}
          </h2>
          <p class="text-primary-600 text-lg max-w-2xl mx-auto">
            {category.description}
          </p>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {category.features.map((feature) => (
            <div class="card p-6 group hover:border-accent-300">
              <div class="w-12 h-12 mb-4 bg-primary-100 rounded-xl flex items-center justify-center group-hover:bg-accent-500 transition-colors duration-300">
                <svg 
                  class="w-6 h-6 text-primary-700 group-hover:text-white transition-colors duration-300" 
                  fill="none" 
                  stroke="currentColor" 
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[feature.icon] || iconPaths.star} />
                </svg>
              </div>
              
              <h3 class="font-display font-semibold text-primary-950 text-lg mb-2">
                {feature.title}
              </h3>
              
              <p class="text-primary-600 text-sm leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}
  
  <CTASection />
</BaseLayout>
