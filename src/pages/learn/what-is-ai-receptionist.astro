---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "What is an AI Receptionist?";
const pageDescription = "Everything you need to know about AI-powered phone answering systems. How they work, what they can do, and whether they're right for your business.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "author": {
    "@type": "Organization",
    "name": "Creative Integrations"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Creative Integrations",
    "logo": {
      "@type": "ImageObject",
      "url": "https://creativeintegrations.ai/images/logo.png"
    }
  },
  "datePublished": "2024-01-15",
  "dateModified": "2024-01-15"
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <!-- Hero -->
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    
    <div class="relative container-width section-padding">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6">
          <span>Fundamentals</span>
          <span class="text-primary-400">•</span>
          <span>5 min read</span>
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-6">
          {pageTitle}
        </h1>
        
        <p class="text-xl text-primary-200">
          {pageDescription}
        </p>
      </div>
    </div>
  </section>
  
  <!-- Article Content -->
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="max-w-3xl mx-auto">
        <article class="prose prose-lg prose-primary max-w-none">
          <p class="lead text-xl text-primary-700">
            An AI receptionist is an artificial intelligence system that answers phone calls for your business, engages callers in natural conversation, and handles tasks like scheduling appointments, answering questions, and qualifying leads — all without human intervention.
          </p>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">How AI Receptionists Work</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Modern AI receptionists use advanced natural language processing (NLP) and speech recognition to understand what callers are saying and respond appropriately. Unlike old-school phone trees with rigid menus, AI receptionists can handle free-flowing conversations.
          </p>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            When someone calls your business, the AI receptionist answers immediately — no wait time, no voicemail. It greets the caller, understands their needs through conversation, and takes the appropriate action: scheduling an appointment, answering a question, gathering information for a callback, or transferring to a human when needed.
          </p>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">What Can an AI Receptionist Do?</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            AI receptionists can handle most of the tasks a human receptionist would:
          </p>
          
          <ul class="space-y-3 mb-6">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Answer calls 24/7</strong> — No missed calls, even at 2 AM or on holidays</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Schedule appointments</strong> — Book directly on your calendar with confirmations</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Answer FAQs</strong> — Handle common questions about services, hours, pricing</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Qualify leads</strong> — Gather information like contact details, needs, budget</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Transfer calls</strong> — Route urgent or complex calls to the right person</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Send follow-ups</strong> — Text confirmations, links, and information to callers</span>
            </li>
          </ul>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">AI Receptionist vs. Traditional Options</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Businesses have traditionally had three options for handling calls: hire a receptionist, use a live answering service, or let calls go to voicemail. Here's how AI compares:
          </p>
          
          <div class="overflow-x-auto mb-8">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b-2 border-primary-200">
                  <th class="py-3 pr-4 font-display font-semibold text-primary-950"></th>
                  <th class="py-3 px-4 font-display font-semibold text-primary-950">AI Receptionist</th>
                  <th class="py-3 px-4 font-display font-semibold text-primary-950">Human Receptionist</th>
                  <th class="py-3 px-4 font-display font-semibold text-primary-950">Live Service</th>
                </tr>
              </thead>
              <tbody class="text-primary-700">
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Availability</td>
                  <td class="py-3 px-4">24/7/365</td>
                  <td class="py-3 px-4">Business hours</td>
                  <td class="py-3 px-4">24/7 (varies)</td>
                </tr>
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Monthly Cost</td>
                  <td class="py-3 px-4">$300-1,000</td>
                  <td class="py-3 px-4">$3,000-5,000+</td>
                  <td class="py-3 px-4">$200-2,000+</td>
                </tr>
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Simultaneous calls</td>
                  <td class="py-3 px-4">Unlimited</td>
                  <td class="py-3 px-4">1</td>
                  <td class="py-3 px-4">Varies</td>
                </tr>
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Business knowledge</td>
                  <td class="py-3 px-4">Custom trained</td>
                  <td class="py-3 px-4">Deep</td>
                  <td class="py-3 px-4">Basic scripts</td>
                </tr>
                <tr>
                  <td class="py-3 pr-4 font-medium">Consistency</td>
                  <td class="py-3 px-4">100%</td>
                  <td class="py-3 px-4">Varies</td>
                  <td class="py-3 px-4">Varies</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Who Should Use an AI Receptionist?</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            AI receptionists work best for service businesses where:
          </p>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• Phone calls are a primary source of leads and bookings</li>
            <li>• Missing calls means losing business to competitors</li>
            <li>• After-hours and emergency calls are common</li>
            <li>• Staff time is better spent on billable work than answering phones</li>
            <li>• Consistent call handling and information gathering is important</li>
          </ul>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Industries that benefit most include home services (HVAC, plumbing, roofing, electrical), healthcare practices, legal firms, real estate, and professional services.
          </p>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Try It Yourself</h2>
          
          <p class="text-primary-700 leading-relaxed mb-6">
            The best way to understand what an AI receptionist can do is to experience it. Call our demo line to have a real conversation with AI:
          </p>
          
          <div class="bg-primary-950 rounded-2xl p-8 text-center">
            <p class="text-primary-300 mb-4">Call our AI demo line:</p>
            <a 
              href="tel:877-482-4368"
              class="inline-flex items-center gap-3 text-3xl font-display font-bold text-white hover:text-accent-400 transition-colors"
            >
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              877-482-4368
            </a>
          </div>
        </article>
        
        <!-- Related Articles -->
        <div class="mt-16 pt-8 border-t border-primary-200">
          <h3 class="font-display font-bold text-primary-950 text-xl mb-6">Related Articles</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            <a href="/learn/ai-answering-service-vs-live-answering" class="card p-4 group hover:border-accent-300">
              <h4 class="font-display font-semibold text-primary-950 group-hover:text-accent-600 transition-colors">
                AI vs Live Answering Service
              </h4>
              <p class="text-primary-600 text-sm mt-1">Compare the options</p>
            </a>
            <a href="/learn/ai-receptionist-cost" class="card p-4 group hover:border-accent-300">
              <h4 class="font-display font-semibold text-primary-950 group-hover:text-accent-600 transition-colors">
                How Much Does It Cost?
              </h4>
              <p class="text-primary-600 text-sm mt-1">Complete pricing breakdown</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <CTASection />
</BaseLayout>
