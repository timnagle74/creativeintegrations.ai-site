---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "How Much Does an AI Receptionist Cost?";
const pageDescription = "Complete pricing breakdown for AI receptionist and phone answering services. What to expect, what affects cost, and how to compare options.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "author": { "@type": "Organization", "name": "Creative Integrations" },
  "publisher": { "@type": "Organization", "name": "Creative Integrations" },
  "datePublished": "2024-01-15",
  "dateModified": "2024-01-15"
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="relative container-width section-padding">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6">
          <span>Pricing</span>
          <span class="text-primary-400">•</span>
          <span>4 min read</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-6">{pageTitle}</h1>
        <p class="text-xl text-primary-200">{pageDescription}</p>
      </div>
    </div>
  </section>
  
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="max-w-3xl mx-auto">
        <article class="prose prose-lg prose-primary max-w-none">
          <p class="lead text-xl text-primary-700">
            AI receptionist services typically cost between $300 and $1,000 per month, depending on features and capabilities. Here's a complete breakdown of what affects pricing and what you should expect to pay.
          </p>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Typical AI Receptionist Pricing</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Most AI receptionist services use flat monthly pricing rather than per-minute or per-call rates. This makes costs predictable regardless of how many calls you receive.
          </p>
          
          <div class="grid sm:grid-cols-3 gap-4 my-8">
            <div class="bg-primary-50 rounded-xl p-6 text-center">
              <div class="text-3xl font-display font-bold text-primary-950">$300-400</div>
              <div class="text-primary-600 text-sm mt-1">Basic Plans</div>
              <p class="text-primary-500 text-xs mt-2">Voice answering, basic scheduling</p>
            </div>
            <div class="bg-accent-50 rounded-xl p-6 text-center border-2 border-accent-200">
              <div class="text-3xl font-display font-bold text-accent-700">$500-700</div>
              <div class="text-primary-600 text-sm mt-1">Mid-Tier Plans</div>
              <p class="text-primary-500 text-xs mt-2">+ Chat, CRM, transfers</p>
            </div>
            <div class="bg-primary-50 rounded-xl p-6 text-center">
              <div class="text-3xl font-display font-bold text-primary-950">$800-1,000+</div>
              <div class="text-primary-600 text-sm mt-1">Premium Plans</div>
              <p class="text-primary-500 text-xs mt-2">+ Custom actions, automation</p>
            </div>
          </div>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">What's Included in the Price</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Most AI receptionist services include these core features in their base pricing:
          </p>
          
          <ul class="space-y-3 mb-6">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>24/7 availability</strong> — No extra charge for after-hours</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Unlimited calls</strong> — Flat rate regardless of volume</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Custom training</strong> — AI learns your business specifics</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Call transcripts</strong> — Records of every conversation</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-primary-700"><strong>Phone number</strong> — Dedicated business line included</span>
            </li>
          </ul>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">One-Time Setup Fees</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Most providers charge a one-time setup fee that covers:
          </p>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• Custom AI training on your business</li>
            <li>• Integration setup with your calendar and CRM</li>
            <li>• Phone number configuration</li>
            <li>• Onboarding and testing</li>
          </ul>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Setup fees typically range from $500 to $2,000 depending on complexity. Some providers waive setup fees for annual commitments.
          </p>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Cost Comparison: AI vs Alternatives</h2>
          
          <div class="overflow-x-auto my-8">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b-2 border-primary-200">
                  <th class="py-3 pr-4 font-display font-semibold text-primary-950">Option</th>
                  <th class="py-3 px-4 font-display font-semibold text-primary-950">Monthly Cost</th>
                  <th class="py-3 px-4 font-display font-semibold text-primary-950">Hours</th>
                </tr>
              </thead>
              <tbody class="text-primary-700">
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Full-time receptionist</td>
                  <td class="py-3 px-4">$3,000-5,000+</td>
                  <td class="py-3 px-4">40 hrs/week</td>
                </tr>
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Part-time receptionist</td>
                  <td class="py-3 px-4">$1,500-2,500</td>
                  <td class="py-3 px-4">20 hrs/week</td>
                </tr>
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Live answering service</td>
                  <td class="py-3 px-4">$200-2,000+</td>
                  <td class="py-3 px-4">24/7 (usage-based)</td>
                </tr>
                <tr class="border-b border-primary-100 bg-accent-50">
                  <td class="py-3 pr-4 font-medium">AI receptionist</td>
                  <td class="py-3 px-4 font-semibold text-accent-700">$300-1,000</td>
                  <td class="py-3 px-4">24/7 (flat rate)</td>
                </tr>
                <tr>
                  <td class="py-3 pr-4 font-medium">Voicemail only</td>
                  <td class="py-3 px-4">$0-50</td>
                  <td class="py-3 px-4">24/7</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">ROI Calculation</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            The real question isn't "what does it cost?" but "what's the return?" Here's a simple way to calculate ROI:
          </p>
          
          <div class="bg-primary-950 rounded-xl p-6 my-6 text-white">
            <h4 class="font-display font-semibold mb-4">Example ROI for a Service Business</h4>
            <div class="space-y-2 text-primary-200">
              <p>Missed calls per month: <span class="text-white font-semibold">20</span></p>
              <p>Conversion rate if answered: <span class="text-white font-semibold">25%</span></p>
              <p>Average job value: <span class="text-white font-semibold">$500</span></p>
              <p class="pt-2 border-t border-primary-700">Revenue recovered: <span class="text-accent-400 font-bold">20 × 25% × $500 = $2,500/month</span></p>
              <p>AI receptionist cost: <span class="text-white font-semibold">$500/month</span></p>
              <p class="text-accent-400 font-bold">Net gain: $2,000/month</p>
            </div>
          </div>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Our Pricing</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            At Creative Integrations, we offer three straightforward plans:
          </p>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li><strong>Pro ($397/month):</strong> AI Voice Employee, webchat widget, automated review responses</li>
            <li><strong>Premium ($697/month):</strong> Everything in Pro plus AI Chat, CRM, mobile app, live transfers</li>
            <li><strong>Elite ($997/month):</strong> Everything in Premium plus appointment booking, custom actions, automated newsletters</li>
          </ul>
          
          <p class="text-primary-700 leading-relaxed mb-6">
            <a href="/pricing" class="text-accent-600 hover:text-accent-700 font-medium">View full pricing details →</a>
          </p>
          
          <div class="bg-accent-50 rounded-xl p-6 my-6">
            <p class="text-primary-700 mb-4">
              Want to experience AI answering before you buy? Call our demo line:
            </p>
            <a href="tel:877-482-4368" class="inline-flex items-center gap-2 text-xl font-display font-bold text-accent-700 hover:text-accent-800">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              877-482-4368
            </a>
          </div>
        </article>
        
        <div class="mt-16 pt-8 border-t border-primary-200">
          <h3 class="font-display font-bold text-primary-950 text-xl mb-6">Related Articles</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            <a href="/learn/what-is-ai-receptionist" class="card p-4 group hover:border-accent-300">
              <h4 class="font-display font-semibold text-primary-950 group-hover:text-accent-600 transition-colors">What is an AI Receptionist?</h4>
              <p class="text-primary-600 text-sm mt-1">Complete overview</p>
            </a>
            <a href="/learn/ai-answering-service-vs-live-answering" class="card p-4 group hover:border-accent-300">
              <h4 class="font-display font-semibold text-primary-950 group-hover:text-accent-600 transition-colors">AI vs Live Answering</h4>
              <p class="text-primary-600 text-sm mt-1">Compare the options</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <CTASection />
</BaseLayout>
