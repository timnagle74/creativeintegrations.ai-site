---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "AI Receptionist Setup Guide";
const pageDescription = "Step-by-step guide to implementing an AI receptionist for your business. What to prepare, what to expect, and how to get the best results.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "author": { "@type": "Organization", "name": "Creative Integrations" },
  "publisher": { "@type": "Organization", "name": "Creative Integrations" },
  "datePublished": "2024-01-15",
  "dateModified": "2024-01-15"
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="relative container-width section-padding">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6">
          <span>How-To</span>
          <span class="text-primary-400">•</span>
          <span>8 min read</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-6">{pageTitle}</h1>
        <p class="text-xl text-primary-200">{pageDescription}</p>
      </div>
    </div>
  </section>
  
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="max-w-3xl mx-auto">
        <article class="prose prose-lg prose-primary max-w-none">
          <p class="lead text-xl text-primary-700">
            Setting up an AI receptionist isn't complicated, but proper preparation ensures you get the best results from day one. Here's everything you need to know to implement AI phone answering for your business.
          </p>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Timeline Overview</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Most businesses are fully operational with AI answering within 1-2 weeks:
          </p>
          
          <div class="relative my-8">
            <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-primary-200"></div>
            
            <div class="relative pl-12 pb-8">
              <div class="absolute left-2 w-5 h-5 bg-accent-500 rounded-full"></div>
              <h4 class="font-display font-semibold text-primary-950">Day 1-2: Discovery & Planning</h4>
              <p class="text-primary-600 text-sm mt-1">Initial consultation, gather business information</p>
            </div>
            
            <div class="relative pl-12 pb-8">
              <div class="absolute left-2 w-5 h-5 bg-accent-500 rounded-full"></div>
              <h4 class="font-display font-semibold text-primary-950">Day 3-5: AI Training</h4>
              <p class="text-primary-600 text-sm mt-1">Configure AI with your services, FAQs, processes</p>
            </div>
            
            <div class="relative pl-12 pb-8">
              <div class="absolute left-2 w-5 h-5 bg-accent-500 rounded-full"></div>
              <h4 class="font-display font-semibold text-primary-950">Day 6-8: Integration Setup</h4>
              <p class="text-primary-600 text-sm mt-1">Connect calendar, CRM, phone systems</p>
            </div>
            
            <div class="relative pl-12 pb-8">
              <div class="absolute left-2 w-5 h-5 bg-accent-500 rounded-full"></div>
              <h4 class="font-display font-semibold text-primary-950">Day 9-10: Testing</h4>
              <p class="text-primary-600 text-sm mt-1">Run test calls, refine responses</p>
            </div>
            
            <div class="relative pl-12">
              <div class="absolute left-2 w-5 h-5 bg-accent-500 rounded-full"></div>
              <h4 class="font-display font-semibold text-primary-950">Day 11+: Go Live</h4>
              <p class="text-primary-600 text-sm mt-1">Launch with monitoring and optimization</p>
            </div>
          </div>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">What You Need to Prepare</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Before setup begins, gather this information:
          </p>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">1. Business Information</h3>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• Business name and how you want it pronounced</li>
            <li>• Business hours (including holidays)</li>
            <li>• Service areas and any territory limitations</li>
            <li>• Contact information for escalations</li>
          </ul>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">2. Services & Pricing</h3>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• List of all services you offer</li>
            <li>• Pricing structure (ranges are fine)</li>
            <li>• What's included in each service</li>
            <li>• Any services you don't offer</li>
          </ul>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">3. Common Questions</h3>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• Top 10-20 questions callers ask</li>
            <li>• How you typically answer each question</li>
            <li>• Any questions that should transfer to a human</li>
          </ul>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">4. Scheduling Preferences</h3>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• How appointments are currently booked</li>
            <li>• Calendar access (Google, Outlook, etc.)</li>
            <li>• Appointment types and durations</li>
            <li>• Buffer time between appointments</li>
            <li>• Who should see booked appointments</li>
          </ul>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">5. Escalation Rules</h3>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• What constitutes an emergency?</li>
            <li>• Who should receive transferred calls?</li>
            <li>• After-hours emergency protocol</li>
            <li>• Situations that require human intervention</li>
          </ul>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">The Setup Process</h2>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">Step 1: Discovery Call</h3>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            You'll have an initial call with your implementation specialist to discuss your business, goals, and specific needs. Come prepared with the information listed above.
          </p>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">Step 2: AI Configuration</h3>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Your AI is trained on your specific business. This includes:
          </p>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• Programming your services and pricing</li>
            <li>• Building FAQ responses</li>
            <li>• Setting up conversation flows</li>
            <li>• Configuring voice and personality</li>
            <li>• Creating custom actions and triggers</li>
          </ul>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">Step 3: Integration</h3>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Your AI is connected to your existing systems:
          </p>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• Calendar integration for real-time booking</li>
            <li>• CRM integration for lead capture</li>
            <li>• Phone system configuration</li>
            <li>• Email notifications setup</li>
            <li>• SMS/text message capabilities</li>
          </ul>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">Step 4: Testing</h3>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Before going live, you'll test the system:
          </p>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• Make test calls to hear how AI handles scenarios</li>
            <li>• Verify calendar bookings work correctly</li>
            <li>• Test emergency escalation procedures</li>
            <li>• Review transcripts and suggest refinements</li>
          </ul>
          
          <h3 class="font-display text-xl font-semibold text-primary-950 mt-8 mb-3">Step 5: Go Live</h3>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Once testing is complete, your AI goes live. Most providers offer:
          </p>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• Soft launch with monitoring</li>
            <li>• First-week optimization based on real calls</li>
            <li>• Ongoing support for adjustments</li>
          </ul>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Tips for Success</h2>
          
          <div class="bg-accent-50 rounded-xl p-6 my-6">
            <h4 class="font-display font-semibold text-primary-950 mb-4">Best Practices</h4>
            <ul class="space-y-3 text-primary-700">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Be thorough:</strong> The more information you provide, the better your AI performs</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Test yourself:</strong> Call your AI like a customer would</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Review transcripts:</strong> Check early conversations for improvement opportunities</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Give feedback:</strong> Tell your provider what's working and what isn't</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Be patient:</strong> AI improves over time as it learns your business</span>
              </li>
            </ul>
          </div>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Ready to Get Started?</h2>
          
          <p class="text-primary-700 leading-relaxed mb-6">
            The first step is experiencing AI answering yourself. Call our demo line:
          </p>
          
          <div class="bg-primary-950 rounded-2xl p-8 text-center">
            <p class="text-primary-300 mb-4">Hear what your callers will experience:</p>
            <a href="tel:877-482-4368" class="inline-flex items-center gap-3 text-3xl font-display font-bold text-white hover:text-accent-400 transition-colors">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              877-482-4368
            </a>
          </div>
        </article>
        
        <div class="mt-16 pt-8 border-t border-primary-200">
          <h3 class="font-display font-bold text-primary-950 text-xl mb-6">Related Articles</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            <a href="/learn/what-is-ai-receptionist" class="card p-4 group hover:border-accent-300">
              <h4 class="font-display font-semibold text-primary-950 group-hover:text-accent-600 transition-colors">What is an AI Receptionist?</h4>
              <p class="text-primary-600 text-sm mt-1">Complete overview</p>
            </a>
            <a href="/learn/ai-receptionist-cost" class="card p-4 group hover:border-accent-300">
              <h4 class="font-display font-semibold text-primary-950 group-hover:text-accent-600 transition-colors">AI Receptionist Pricing</h4>
              <p class="text-primary-600 text-sm mt-1">What to expect cost-wise</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <CTASection />
</BaseLayout>
