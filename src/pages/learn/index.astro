---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "Resources & Guides";
const pageDescription = "Learn everything about AI receptionists, answering services, and business automation. Guides, comparisons, and insights to help you make the right decision.";

const guides = [
  {
    title: "What is an AI Receptionist?",
    description: "Everything you need to know about AI-powered phone answering systems and how they work for local businesses.",
    slug: "what-is-ai-receptionist",
    category: "Fundamentals",
    readTime: "5 min read"
  },
  {
    title: "AI Answering Service vs Live Answering Service",
    description: "Compare the pros, cons, and costs of AI phone answering versus traditional live receptionist services.",
    slug: "ai-answering-service-vs-live-answering",
    category: "Comparisons",
    readTime: "7 min read"
  },
  {
    title: "How Much Does an AI Phone Answering Service Cost?",
    description: "Complete pricing breakdown for AI receptionist services. What to expect and what affects the cost.",
    slug: "ai-receptionist-cost",
    category: "Pricing",
    readTime: "4 min read"
  },
  {
    title: "Speed to Lead: Why Response Time Matters",
    description: "The statistics behind lead response time and why being first to answer wins more business.",
    slug: "speed-to-lead-statistics",
    category: "Insights",
    readTime: "6 min read"
  },
  {
    title: "AI Receptionist Setup Guide",
    description: "Step-by-step guide to implementing an AI receptionist for your business. What to prepare and expect.",
    slug: "ai-receptionist-setup-guide",
    category: "How-To",
    readTime: "8 min read"
  },
  {
    title: "The True Cost of Missed Calls",
    description: "Calculate how much revenue your business loses from missed calls and slow response times.",
    slug: "missed-call-revenue-calculator",
    category: "Tools",
    readTime: "3 min read"
  }
];

const categories = [...new Set(guides.map(g => g.category))];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="absolute top-0 left-1/3 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
    
    <div class="relative container-width section-padding text-center">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
        Resources &<br />
        <span class="text-gradient">Learning Center</span>
      </h1>
      <p class="text-xl text-primary-200 max-w-2xl mx-auto">
        Guides, comparisons, and insights to help you understand AI business automation and make informed decisions.
      </p>
    </div>
  </section>
  
  <!-- Guides Grid -->
  <section class="section-padding bg-white">
    <div class="container-width">
      <!-- Category Filter (visual only for now) -->
      <div class="flex flex-wrap gap-2 mb-8 justify-center">
        <button class="px-4 py-2 bg-primary-950 text-white rounded-full text-sm font-medium">
          All
        </button>
        {categories.map((cat) => (
          <button class="px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-medium hover:bg-primary-200 transition-colors">
            {cat}
          </button>
        ))}
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {guides.map((guide) => (
          <a 
            href={`/learn/${guide.slug}`}
            class="card p-6 group hover:border-accent-300 hover:shadow-lg transition-all duration-300"
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-accent-100 text-accent-700 text-xs font-medium rounded-full">
                {guide.category}
              </span>
              <span class="text-primary-400 text-xs">{guide.readTime}</span>
            </div>
            
            <h2 class="font-display font-semibold text-primary-950 text-xl mb-3 group-hover:text-accent-600 transition-colors">
              {guide.title}
            </h2>
            
            <p class="text-primary-600 text-sm leading-relaxed mb-4">
              {guide.description}
            </p>
            
            <span class="inline-flex items-center text-accent-600 text-sm font-medium">
              Read guide
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Newsletter CTA -->
  <section class="section-padding bg-gradient-section">
    <div class="container-width">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="font-display text-3xl font-bold text-primary-950 mb-4">
          Stay Updated
        </h2>
        <p class="text-primary-600 mb-6">
          Get the latest guides, tips, and insights on AI business automation delivered to your inbox.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input 
            type="email" 
            placeholder="Enter your email" 
            class="flex-1 px-4 py-3 rounded-lg border border-primary-200 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none"
          />
          <button class="btn-primary whitespace-nowrap">
            Subscribe
          </button>
        </div>
        <p class="text-primary-400 text-sm mt-3">No spam. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>
  
  <CTASection variant="dark" />
</BaseLayout>
