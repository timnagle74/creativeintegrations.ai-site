---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const pageTitle = "The True Cost of Missed Calls";
const pageDescription = "Calculate how much revenue your business loses from missed calls. Use our calculator to see the real impact on your bottom line.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "author": { "@type": "Organization", "name": "Creative Integrations" },
  "publisher": { "@type": "Organization", "name": "Creative Integrations" },
  "datePublished": "2024-01-15",
  "dateModified": "2024-01-15"
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <section class="bg-gradient-hero relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="relative container-width section-padding">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6">
          <span>Tools</span>
          <span class="text-primary-400">•</span>
          <span>3 min read</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-6">{pageTitle}</h1>
        <p class="text-xl text-primary-200">{pageDescription}</p>
      </div>
    </div>
  </section>
  
  <section class="section-padding bg-white">
    <div class="container-width">
      <div class="max-w-3xl mx-auto">
        <article class="prose prose-lg prose-primary max-w-none">
          <p class="lead text-xl text-primary-700">
            Every missed call is money walking out the door. But how much exactly? Let's break down the math so you can see what unanswered calls really cost your business.
          </p>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">The Missed Call Formula</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Here's the simple formula to calculate your missed call losses:
          </p>
          
          <div class="bg-primary-950 rounded-xl p-6 my-6 text-center">
            <p class="text-primary-300 text-sm mb-2">Lost Revenue =</p>
            <p class="text-white font-display text-lg">
              Missed Calls × Lost Lead Rate × Conversion Rate × Average Job Value
            </p>
          </div>
          
          <p class="text-primary-700 leading-relaxed mb-4">Let's define each variable:</p>
          
          <ul class="space-y-3 mb-6 text-primary-700">
            <li><strong>Missed Calls:</strong> How many calls go unanswered (voicemail, busy, after hours)</li>
            <li><strong>Lost Lead Rate:</strong> 85% of callers who reach voicemail never call back</li>
            <li><strong>Conversion Rate:</strong> Your percentage of leads that become paying customers</li>
            <li><strong>Average Job Value:</strong> What a typical customer is worth to your business</li>
          </ul>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Calculate Your Losses</h2>
          
          <!-- Interactive Calculator -->
          <div class="bg-gradient-to-br from-primary-50 to-accent-50 rounded-2xl p-6 sm:p-8 my-8">
            <h3 class="font-display font-bold text-primary-950 text-xl mb-6">Missed Call Calculator</h3>
            
            <div class="space-y-6">
              <div>
                <label class="block text-sm font-medium text-primary-700 mb-2">
                  Missed calls per week
                </label>
                <input 
                  type="number" 
                  id="missedCalls" 
                  value="5"
                  min="0"
                  class="w-full px-4 py-3 rounded-lg border border-primary-200 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-primary-700 mb-2">
                  Your conversion rate (%)
                </label>
                <input 
                  type="number" 
                  id="conversionRate" 
                  value="25"
                  min="0"
                  max="100"
                  class="w-full px-4 py-3 rounded-lg border border-primary-200 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium text-primary-700 mb-2">
                  Average job value ($)
                </label>
                <input 
                  type="number" 
                  id="jobValue" 
                  value="500"
                  min="0"
                  class="w-full px-4 py-3 rounded-lg border border-primary-200 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none"
                />
              </div>
              
              <button 
                id="calculateBtn"
                class="btn-primary w-full text-lg py-4"
              >
                Calculate My Losses
              </button>
              
              <div id="results" class="hidden">
                <div class="bg-white rounded-xl p-6 mt-4 border-2 border-accent-200">
                  <h4 class="font-display font-semibold text-primary-950 mb-4">Your Estimated Losses</h4>
                  <div class="grid grid-cols-2 gap-4">
                    <div class="text-center p-4 bg-primary-50 rounded-lg">
                      <div id="weeklyLoss" class="text-2xl font-display font-bold text-accent-600">$0</div>
                      <div class="text-primary-600 text-sm">Per Week</div>
                    </div>
                    <div class="text-center p-4 bg-primary-50 rounded-lg">
                      <div id="monthlyLoss" class="text-2xl font-display font-bold text-accent-600">$0</div>
                      <div class="text-primary-600 text-sm">Per Month</div>
                    </div>
                    <div class="col-span-2 text-center p-4 bg-accent-100 rounded-lg">
                      <div id="yearlyLoss" class="text-3xl font-display font-bold text-accent-700">$0</div>
                      <div class="text-primary-600 text-sm">Per Year</div>
                    </div>
                  </div>
                  <p class="text-primary-500 text-sm mt-4 text-center">
                    Based on 85% of missed calls never calling back
                  </p>
                </div>
              </div>
            </div>
          </div>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">Industry Benchmarks</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            Here's what typical service businesses lose to missed calls:
          </p>
          
          <div class="overflow-x-auto my-8">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b-2 border-primary-200">
                  <th class="py-3 pr-4 font-display font-semibold text-primary-950">Industry</th>
                  <th class="py-3 px-4 font-display font-semibold text-primary-950">Avg Job Value</th>
                  <th class="py-3 px-4 font-display font-semibold text-primary-950">5 Missed/Week</th>
                </tr>
              </thead>
              <tbody class="text-primary-700">
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Roofing</td>
                  <td class="py-3 px-4">$8,000</td>
                  <td class="py-3 px-4 text-accent-600 font-semibold">$44,200/year</td>
                </tr>
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">HVAC</td>
                  <td class="py-3 px-4">$500</td>
                  <td class="py-3 px-4 text-accent-600 font-semibold">$2,762/year</td>
                </tr>
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Plumbing</td>
                  <td class="py-3 px-4">$350</td>
                  <td class="py-3 px-4 text-accent-600 font-semibold">$1,933/year</td>
                </tr>
                <tr class="border-b border-primary-100">
                  <td class="py-3 pr-4 font-medium">Legal Services</td>
                  <td class="py-3 px-4">$3,000</td>
                  <td class="py-3 px-4 text-accent-600 font-semibold">$16,575/year</td>
                </tr>
                <tr>
                  <td class="py-3 pr-4 font-medium">Dental</td>
                  <td class="py-3 px-4">$1,200</td>
                  <td class="py-3 px-4 text-accent-600 font-semibold">$6,630/year</td>
                </tr>
              </tbody>
            </table>
          </div>
          
          <p class="text-primary-500 text-sm">
            *Assumes 25% conversion rate and 85% lost lead rate
          </p>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">The Hidden Costs</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            The calculator above only measures direct revenue loss. It doesn't account for:
          </p>
          
          <ul class="space-y-2 mb-6 text-primary-700">
            <li>• <strong>Referrals:</strong> Every lost customer means lost referral potential</li>
            <li>• <strong>Lifetime value:</strong> Repeat customers and ongoing relationships</li>
            <li>• <strong>Reviews:</strong> Fewer customers means fewer positive reviews</li>
            <li>• <strong>Competitor advantage:</strong> Your loss is literally their gain</li>
          </ul>
          
          <h2 class="font-display text-2xl font-bold text-primary-950 mt-12 mb-4">The Solution</h2>
          
          <p class="text-primary-700 leading-relaxed mb-4">
            AI answering services eliminate missed calls entirely. For $397-997/month, you get 24/7 coverage that pays for itself many times over.
          </p>
          
          <p class="text-primary-700 leading-relaxed mb-6">
            Call our demo line to see how it works:
          </p>
          
          <div class="bg-primary-950 rounded-2xl p-8 text-center">
            <p class="text-primary-300 mb-4">Stop losing money to missed calls:</p>
            <a href="tel:877-482-4368" class="inline-flex items-center gap-3 text-3xl font-display font-bold text-white hover:text-accent-400 transition-colors">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              877-482-4368
            </a>
          </div>
        </article>
        
        <div class="mt-16 pt-8 border-t border-primary-200">
          <h3 class="font-display font-bold text-primary-950 text-xl mb-6">Related Articles</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            <a href="/learn/speed-to-lead-statistics" class="card p-4 group hover:border-accent-300">
              <h4 class="font-display font-semibold text-primary-950 group-hover:text-accent-600 transition-colors">Speed to Lead Statistics</h4>
              <p class="text-primary-600 text-sm mt-1">Why response time matters</p>
            </a>
            <a href="/learn/ai-receptionist-cost" class="card p-4 group hover:border-accent-300">
              <h4 class="font-display font-semibold text-primary-950 group-hover:text-accent-600 transition-colors">AI Receptionist Pricing</h4>
              <p class="text-primary-600 text-sm mt-1">What it costs to solve this</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <CTASection />
</BaseLayout>

<script>
  const calculateBtn = document.getElementById('calculateBtn');
  const results = document.getElementById('results');
  
  calculateBtn?.addEventListener('click', () => {
    const missedCalls = parseFloat((document.getElementById('missedCalls') as HTMLInputElement).value) || 0;
    const conversionRate = parseFloat((document.getElementById('conversionRate') as HTMLInputElement).value) / 100 || 0;
    const jobValue = parseFloat((document.getElementById('jobValue') as HTMLInputElement).value) || 0;
    
    const lostLeadRate = 0.85;
    
    const weeklyLoss = missedCalls * lostLeadRate * conversionRate * jobValue;
    const monthlyLoss = weeklyLoss * 4.33;
    const yearlyLoss = weeklyLoss * 52;
    
    document.getElementById('weeklyLoss')!.textContent = '$' + Math.round(weeklyLoss).toLocaleString();
    document.getElementById('monthlyLoss')!.textContent = '$' + Math.round(monthlyLoss).toLocaleString();
    document.getElementById('yearlyLoss')!.textContent = '$' + Math.round(yearlyLoss).toLocaleString();
    
    results?.classList.remove('hidden');
  });
</script>
