---
/**
 * FeatureShowcase - Alternating feature blocks with scroll-triggered animations
 * Each feature gets a hero-style treatment with visuals
 */

interface Feature {
  id: string;
  badge: string;
  badgeIcon: string;
  headline: string;
  description: string;
  stats?: { value: string; label: string }[];
  visual: 'voice' | 'chat' | 'reviews' | 'availability' | 'workflow' | 'calendar' | 'mobile';
}

const features: Feature[] = [
  {
    id: 'voice',
    badge: 'Voice AI',
    badgeIcon: 'M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z',
    headline: 'Maximize phone call engagement',
    description: 'Never miss another call. AI Voice Employee answers instantly, qualifies leads, books appointments, and transfers urgent calls to your team — 24/7.',
    stats: [
      { value: '67%', label: 'of customers hang up without immediate assistance' },
      { value: '85%', label: 'of missed calls never call back' },
      { value: '92%', label: 'of customer interactions happen over the phone' },
      { value: '75%', label: 'of consumers believe calling is fastest for response' },
    ]
  },
  {
    id: 'chat',
    badge: 'Chat AI',
    badgeIcon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
    headline: 'Immediately responding to Texts & Chats turn leads into customers',
    description: 'Maximizing engagement means turning every interaction into an opportunity for growth. By implementing effective strategies, you can foster deeper connections with your customers, improve response rates, and enhance overall communication.',
  },
  {
    id: 'reviews',
    badge: 'Reviews AI',
    badgeIcon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z',
    headline: 'Draw in new customers through positive reviews',
    description: 'Positive reviews act as powerful endorsements that can influence potential customers and boost your credibility. By showcasing authentic feedback, you can build trust, enhance your reputation, and stand out in a competitive market.',
  },
  {
    id: 'availability',
    badge: '24/7 on call',
    badgeIcon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    headline: 'Double the speed of lead generation',
    description: 'Speed up your lead generation efforts, ensuring you reach potential customers more quickly and efficiently. By streamlining your process, you can maximize outreach, increase conversion rates, and stay ahead of the competition.',
  },
  {
    id: 'workflow',
    badge: 'Workflow AI',
    badgeIcon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
    headline: 'Create intelligent, data-driven campaigns',
    description: 'Develop campaigns that are not only effective but also efficient, using intelligent strategies to reach the right audience at the right time. By leveraging data and advanced tools, you can create personalized experiences that drive higher engagement and deliver measurable success.',
  },
  {
    id: 'calendar',
    badge: 'Calendar',
    badgeIcon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
    headline: 'Instantly fill your calendar',
    description: 'Say goodbye to missed sales opportunities! Creative Integrations makes scheduling appointments feel magically easy so that you can close more deals!',
  },
  {
    id: 'mobile',
    badge: 'Mobile App',
    badgeIcon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
    headline: 'AI powered CRM in the palm of your hands',
    description: 'Develop campaigns that are not only effective but also efficient, using intelligent strategies to reach the right audience at the right time. By leveraging data and advanced tools, you can create personalized experiences that drive higher engagement and deliver measurable success.',
  },
];
---

<section class="py-16 lg:py-24 bg-gradient-to-b from-white to-primary-50">
  <div class="container-width">
    {features.map((feature, index) => (
      <div 
        class="feature-block py-16 lg:py-24 border-b border-primary-100 last:border-0"
        data-feature={feature.id}
      >
        <div class:list={[
          "grid lg:grid-cols-2 gap-12 lg:gap-16 items-center",
          index % 2 === 1 ? "lg:flex-row-reverse" : ""
        ]}>
          <!-- Content -->
          <div class:list={[
            "scroll-animate",
            index % 2 === 1 ? "lg:order-2" : ""
          ]} data-animate="fade-right">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 rounded-full mb-6">
              <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.badgeIcon} />
                </svg>
              </div>
              <span class="text-blue-600 font-semibold">{feature.badge}</span>
            </div>
            
            <!-- Headline -->
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-primary-950 mb-6 leading-tight">
              {feature.headline}
            </h2>
            
            <!-- Description -->
            <p class="text-primary-600 text-lg leading-relaxed mb-8">
              {feature.description}
            </p>
            
            <!-- Stats (if present) -->
            {feature.stats && (
              <div class="space-y-4">
                {feature.stats.map((stat) => (
                  <div class="flex items-start gap-3">
                    <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <p class="text-primary-700">
                      <span class="font-bold text-primary-950">{stat.value}</span> {stat.label}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>
          
          <!-- Visual -->
          <div class:list={[
            "scroll-animate",
            index % 2 === 1 ? "lg:order-1" : ""
          ]} data-animate={index % 2 === 0 ? "fade-left" : "fade-right"}>
            <div class="relative">
              <!-- Placeholder for custom visuals - using CSS mockups -->
              {feature.visual === 'voice' && (
                <div class="relative">
                  <!-- Main image placeholder -->
                  <div class="bg-gradient-to-br from-primary-100 to-primary-200 rounded-3xl aspect-[4/3] flex items-center justify-center overflow-hidden">
                    <div class="text-center p-8">
                      <!-- Phone mockup -->
                      <div class="inline-block bg-white rounded-3xl shadow-2xl p-4 mb-4">
                        <div class="w-48 h-64 bg-gray-100 rounded-2xl flex flex-col items-center justify-center">
                          <div class="w-16 h-16 bg-gradient-to-br from-blue-400 to-blue-600 rounded-full flex items-center justify-center mb-3">
                            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </svg>
                          </div>
                          <div class="font-semibold text-gray-800">Jessica Davis</div>
                          <div class="text-sm text-gray-500 mb-4">Calling...</div>
                          <div class="flex gap-4">
                            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center">
                              <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 24 24"><path d="M19 11h-1.7c0 .74-.16 1.43-.43 2.05l1.23 1.23c.56-.98.9-2.09.9-3.28zm-4.02.17c0-.06.02-.11.02-.17V5c0-1.66-1.34-3-3-3S9 3.34 9 5v.18l5.98 5.99zM4.27 3L3 4.27l6.01 6.01V11c0 1.66 1.33 3 2.99 3 .22 0 .44-.03.65-.08l1.66 1.66c-.71.33-1.5.52-2.31.52-2.76 0-5.3-2.1-5.3-5.1H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c.91-.13 1.77-.45 2.54-.9L19.73 21 21 19.73 4.27 3z"/></svg>
                            </div>
                            <div class="w-12 h-12 bg-red-500 rounded-full flex items-center justify-center">
                              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85-.18.18-.43.28-.7.28-.28 0-.53-.11-.71-.29L.29 13.08c-.18-.17-.29-.42-.29-.7 0-.28.11-.53.29-.71C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67c.18.18.29.43.29.71 0 .28-.11.53-.29.71l-2.48 2.48c-.18.18-.43.29-.71.29-.27 0-.52-.11-.7-.28-.79-.74-1.68-1.36-2.66-1.85-.33-.16-.56-.5-.56-.9v-3.1C15.15 9.25 13.6 9 12 9z"/></svg>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- Floating call queue -->
                  <div class="absolute -right-4 top-8 bg-white rounded-xl shadow-lg p-4 w-48 hidden lg:block">
                    <div class="text-xs font-semibold text-gray-500 mb-2">Pending Calls</div>
                    {['John Smith', 'Jane Doe', 'Mark Johnson'].map((name, i) => (
                      <div class="flex items-center gap-2 py-2 border-b border-gray-100 last:border-0">
                        <div class="w-8 h-8 bg-gray-200 rounded-full"></div>
                        <div class="flex-1">
                          <div class="text-sm font-medium text-gray-800">{name}</div>
                          <div class="text-xs text-gray-400">Mobile</div>
                        </div>
                        <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center">
                          <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              
              {feature.visual === 'chat' && (
                <div class="bg-gradient-to-br from-blue-50 to-primary-100 rounded-3xl p-8 aspect-[4/3] flex items-center justify-center">
                  <!-- Phone with chat -->
                  <div class="bg-white rounded-[2.5rem] shadow-2xl p-3 w-64">
                    <div class="bg-gray-100 rounded-[2rem] overflow-hidden">
                      <div class="bg-white px-4 py-3 flex items-center gap-3 border-b">
                        <div class="w-10 h-10 bg-blue-500 rounded-full"></div>
                        <div>
                          <div class="font-semibold text-sm">John Smith</div>
                          <div class="text-xs text-gray-400">Text Message</div>
                        </div>
                      </div>
                      <div class="p-4 space-y-3 h-48">
                        <div class="bg-gray-200 rounded-2xl rounded-bl-sm px-4 py-2 text-sm max-w-[80%]">
                          Hi! I'm Kevin from Harper & Quinn Law Partners.
                        </div>
                        <div class="bg-blue-500 text-white rounded-2xl rounded-br-sm px-4 py-2 text-sm max-w-[80%] ml-auto">
                          Oh, hi Kevin. I'm doing okay, thanks.
                        </div>
                        <div class="bg-gray-200 rounded-2xl rounded-bl-sm px-4 py-2 text-sm max-w-[80%]">
                          That's good to hear! How can I help?
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}
              
              {feature.visual === 'reviews' && (
                <div class="bg-gradient-to-br from-amber-50 to-orange-100 rounded-3xl p-8 aspect-[4/3] flex items-center justify-center relative">
                  <!-- Center person placeholder -->
                  <div class="w-32 h-32 bg-gradient-to-br from-yellow-200 to-yellow-300 rounded-full"></div>
                  
                  <!-- Floating review cards -->
                  <div class="absolute top-8 left-8 bg-white rounded-xl shadow-lg p-3 w-40">
                    <div class="flex gap-0.5 mb-1">
                      {[1,2,3,4,5].map(() => (
                        <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      ))}
                    </div>
                    <div class="text-xs text-gray-600">Great service!</div>
                  </div>
                  
                  <div class="absolute top-8 right-8 bg-white rounded-xl shadow-lg p-3 w-36">
                    <div class="flex gap-0.5 mb-1">
                      {[1,2,3,4,5].map(() => (
                        <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      ))}
                    </div>
                    <div class="text-xs text-gray-600">Highly recommend</div>
                  </div>
                  
                  <div class="absolute bottom-8 right-12 bg-white rounded-xl shadow-lg p-3 w-44">
                    <div class="flex gap-0.5 mb-1">
                      {[1,2,3,4,5].map(() => (
                        <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      ))}
                    </div>
                    <div class="text-xs text-gray-600">Professional team!</div>
                  </div>
                </div>
              )}
              
              {feature.visual === 'availability' && (
                <div class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-3xl p-8 aspect-[4/3] flex items-center justify-center">
                  <div class="text-center">
                    <div class="inline-flex items-center justify-center w-24 h-24 bg-blue-500 rounded-full mb-6">
                      <span class="text-4xl font-bold text-white">24/7</span>
                    </div>
                    <div class="text-xl font-bold text-primary-950">Always Available</div>
                  </div>
                </div>
              )}
              
              {feature.visual === 'workflow' && (
                <div class="bg-gradient-to-br from-purple-50 to-indigo-100 rounded-3xl p-8 aspect-[4/3]">
                  <!-- Workflow mockup -->
                  <div class="bg-white rounded-xl shadow-lg p-4 h-full">
                    <div class="space-y-3">
                      <div class="text-sm font-semibold text-gray-500">When</div>
                      <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg">
                        <div class="w-6 h-6 bg-green-500 rounded"></div>
                        <span class="text-sm">New Lead Submits Form</span>
                      </div>
                      <div class="text-sm font-semibold text-gray-500 pt-2">Then</div>
                      <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg">
                        <div class="w-6 h-6 bg-blue-500 rounded"></div>
                        <span class="text-sm">Send Welcome Email</span>
                      </div>
                      <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg">
                        <div class="w-6 h-6 bg-blue-500 rounded"></div>
                        <span class="text-sm">Wait 1 hour</span>
                      </div>
                      <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg">
                        <div class="w-6 h-6 bg-blue-500 rounded"></div>
                        <span class="text-sm">Send Follow Up Text</span>
                      </div>
                    </div>
                  </div>
                </div>
              )}
              
              {feature.visual === 'calendar' && (
                <div class="bg-gradient-to-br from-blue-50 to-cyan-100 rounded-3xl p-8 aspect-[4/3] flex items-center justify-center">
                  <!-- Calendar mockup -->
                  <div class="bg-white rounded-xl shadow-2xl p-4 w-full max-w-xs">
                    <div class="text-center mb-4">
                      <div class="font-semibold text-gray-800">January 2026</div>
                    </div>
                    <div class="grid grid-cols-7 gap-1 text-center text-xs mb-2">
                      {['S','M','T','W','T','F','S'].map(d => (
                        <div class="text-gray-400 font-medium">{d}</div>
                      ))}
                    </div>
                    <div class="grid grid-cols-7 gap-1 text-center text-sm">
                      {[...Array(31)].map((_, i) => (
                        <div class:list={[
                          "py-1 rounded",
                          i === 7 ? "bg-blue-500 text-white" : "hover:bg-gray-100"
                        ]}>{i + 1}</div>
                      ))}
                    </div>
                  </div>
                </div>
              )}
              
              {feature.visual === 'mobile' && (
                <div class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-3xl p-8 aspect-[4/3] flex items-center justify-center">
                  <!-- Multiple phones -->
                  <div class="flex -space-x-8">
                    <div class="bg-white rounded-3xl shadow-xl p-2 w-40 transform -rotate-6">
                      <div class="bg-gray-800 rounded-2xl h-64 p-3">
                        <div class="text-white text-xs mb-2">Dashboard</div>
                        <div class="space-y-2">
                          <div class="bg-gray-700 rounded p-2 text-xs text-gray-300">5 Opportunities</div>
                          <div class="bg-gray-700 rounded p-2 text-xs text-gray-300">$200 Pipeline</div>
                        </div>
                      </div>
                    </div>
                    <div class="bg-white rounded-3xl shadow-xl p-2 w-44 z-10">
                      <div class="bg-gray-100 rounded-2xl h-72 p-3">
                        <div class="text-gray-800 text-sm font-semibold mb-2">Recent Activity</div>
                        <div class="space-y-2">
                          <div class="bg-white rounded p-2 text-xs shadow-sm">New message from Alex</div>
                          <div class="bg-white rounded p-2 text-xs shadow-sm">Appointment booked</div>
                          <div class="bg-white rounded p-2 text-xs shadow-sm">New lead captured</div>
                        </div>
                      </div>
                    </div>
                    <div class="bg-white rounded-3xl shadow-xl p-2 w-40 transform rotate-6">
                      <div class="bg-gray-100 rounded-2xl h-64 p-3">
                        <div class="text-gray-800 text-xs mb-2">Contacts</div>
                        <div class="space-y-2">
                          {['Steve', 'Bruce', 'Daniel'].map(name => (
                            <div class="flex items-center gap-2">
                              <div class="w-6 h-6 bg-gray-300 rounded-full"></div>
                              <span class="text-xs">{name}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Scroll animations */
  .scroll-animate {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  
  .scroll-animate[data-animate="fade-left"] {
    transform: translateX(60px);
  }
  
  .scroll-animate[data-animate="fade-right"] {
    transform: translateX(-60px);
  }
  
  .scroll-animate.animate-in {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  // Intersection Observer for scroll animations
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.2
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
      }
    });
  }, observerOptions);
  
  document.querySelectorAll('.scroll-animate').forEach(el => {
    observer.observe(el);
  });
</script>
