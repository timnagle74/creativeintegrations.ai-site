---
/**
 * FeatureShowcase - Alternating feature blocks with scroll-triggered animations
 * Each feature gets a hero-style treatment with visuals
 */

interface Feature {
  id: string;
  badge: string;
  badgeIcon: string;
  headline: string;
  description: string;
  stats?: { value: string; label: string }[];
  visual: 'voice' | 'chat' | 'reviews' | 'workflow' | 'calendar' | 'mobile';
  image: string;
  imageAlt: string;
}

const features: Feature[] = [
  {
    id: 'voice',
    badge: 'Voice AI - 24/7',
    badgeIcon: 'M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z',
    headline: 'Your AI receptionist that never sleeps',
    description: 'Never miss another call - day or night. Your AI Voice Employee answers instantly 24/7, qualifies leads, books appointments, and transfers urgent calls to your team. While you sleep, your business keeps winning.',
    image: '/images/features/voice-ai.png',
    imageAlt: 'AI voice assistant answering calls 24/7',
    stats: [
      { value: '67%', label: 'of customers hang up without immediate assistance' },
      { value: '85%', label: 'of missed calls never call back' },
      { value: '92%', label: 'of customer interactions happen over the phone' },
      { value: '24/7', label: 'availability - your AI never takes a break' },
    ]
  },
  {
    id: 'chat',
    badge: 'Chat AI',
    badgeIcon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
    headline: 'Immediately responding to Texts & Chats turn leads into customers',
    description: 'Maximizing engagement means turning every interaction into an opportunity for growth. By implementing effective strategies, you can foster deeper connections with your customers, improve response rates, and enhance overall communication.',
    image: '/images/features/chat-ai.png',
    imageAlt: 'iPhone showing business text message conversation',
  },
  {
    id: 'reviews',
    badge: 'Reviews AI',
    badgeIcon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z',
    headline: 'Draw in new customers through positive reviews',
    description: 'Positive reviews act as powerful endorsements that can influence potential customers and boost your credibility. By showcasing authentic feedback, you can build trust, enhance your reputation, and stand out in a competitive market.',
    image: '/images/features/reviews-ai.png',
    imageAlt: 'Happy business owner viewing 5-star reviews on tablet',
  },
  {
    id: 'workflow',
    badge: 'Workflow AI',
    badgeIcon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
    headline: 'Create intelligent, data-driven campaigns',
    description: 'Develop campaigns that are not only effective but also efficient, using intelligent strategies to reach the right audience at the right time. By leveraging data and advanced tools, you can create personalized experiences that drive higher engagement and deliver measurable success.',
    image: '/images/features/workflow-ai.png',
    imageAlt: 'Laptop showing workflow automation builder interface',
  },
  {
    id: 'calendar',
    badge: 'Calendar',
    badgeIcon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
    headline: 'Instantly fill your calendar',
    description: 'Say goodbye to missed sales opportunities! Creative Integrations makes scheduling appointments feel magically easy so that you can close more deals!',
    image: '/images/features/calendar.png',
    imageAlt: 'Tablet showing appointment scheduling calendar',
  },
  {
    id: 'mobile',
    badge: 'Mobile App',
    badgeIcon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
    headline: 'AI powered CRM in the palm of your hands',
    description: 'Develop campaigns that are not only effective but also efficient, using intelligent strategies to reach the right audience at the right time. By leveraging data and advanced tools, you can create personalized experiences that drive higher engagement and deliver measurable success.',
    image: '/images/features/mobile-app.png',
    imageAlt: 'Three smartphones showing CRM mobile app dashboards',
  },
];
---

<section class="py-16 lg:py-24 bg-gradient-to-b from-white to-primary-50">
  <div class="container-width">
    {features.map((feature, index) => (
      <div 
        class="feature-block py-16 lg:py-24 border-b border-primary-100 last:border-0"
        data-feature={feature.id}
      >
        <div class:list={[
          "grid lg:grid-cols-2 gap-12 lg:gap-16 items-center",
          index % 2 === 1 ? "lg:flex-row-reverse" : ""
        ]}>
          <!-- Content -->
          <div class:list={[
            "scroll-animate",
            index % 2 === 1 ? "lg:order-2" : ""
          ]} data-animate="fade-right">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 rounded-full mb-6">
              <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.badgeIcon} />
                </svg>
              </div>
              <span class="text-blue-600 font-semibold">{feature.badge}</span>
            </div>
            
            <!-- Headline -->
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-primary-950 mb-6 leading-tight">
              {feature.headline}
            </h2>
            
            <!-- Description -->
            <p class="text-primary-600 text-lg leading-relaxed mb-8">
              {feature.description}
            </p>
            
            <!-- Stats (if present) -->
            {feature.stats && (
              <div class="space-y-4">
                {feature.stats.map((stat) => (
                  <div class="flex items-start gap-3">
                    <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <p class="text-primary-700">
                      <span class="font-bold text-primary-950">{stat.value}</span> {stat.label}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>
          
          <!-- Visual -->
          <div class:list={[
            "scroll-animate",
            index % 2 === 1 ? "lg:order-1" : ""
          ]} data-animate={index % 2 === 0 ? "fade-left" : "fade-right"}>
            <div class="relative">
              <img 
                src={feature.image}
                alt={feature.imageAlt}
                class="rounded-3xl shadow-2xl w-full"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Scroll animations */
  .scroll-animate {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  
  .scroll-animate[data-animate="fade-left"] {
    transform: translateX(60px);
  }
  
  .scroll-animate[data-animate="fade-right"] {
    transform: translateX(-60px);
  }
  
  .scroll-animate.animate-in {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  // Intersection Observer for scroll animations
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.2
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
      }
    });
  }, observerOptions);
  
  document.querySelectorAll('.scroll-animate').forEach(el => {
    observer.observe(el);
  });
</script>
