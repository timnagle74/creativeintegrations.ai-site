---
interface Stat {
  value: string;
  label: string;
  description: string;
  icon: string;
}

const stats: Stat[] = [
  {
    value: "67%",
    label: "Hang Up Without Help",
    description: "of customers hang up if they don't receive immediate assistance when calling.",
    icon: "phone-missed"
  },
  {
    value: "85%",
    label: "Never Call Back",
    description: "of missed calls never call back. That's business slipping through your fingers.",
    icon: "trending-down"
  },
  {
    value: "93%",
    label: "Read Reviews First",
    description: "of people read online reviews before making a purchase decision.",
    icon: "star"
  }
];

const iconPaths: Record<string, string> = {
  "phone-missed": "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  "trending-down": "M13 17h8m0 0V9m0 8l-8-8-4 4-6-6",
  "star": "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
};
---

<section class="bg-gradient-section section-padding">
  <div class="container-width">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
        The Problem: Missed Calls = Lost Revenue
      </h2>
      <p class="text-primary-600 text-lg max-w-2xl mx-auto">
        Speed to lead drives sales, and reviews close the loop. Every missed opportunity costs you money.
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {stats.map((stat, index) => (
        <div 
          class="card p-8 text-center group hover:scale-105 transition-transform duration-300"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="w-16 h-16 mx-auto mb-6 bg-accent-100 rounded-2xl flex items-center justify-center group-hover:bg-accent-500 transition-colors duration-300">
            <svg 
              class="w-8 h-8 text-accent-600 group-hover:text-white transition-colors duration-300" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[stat.icon]} />
            </svg>
          </div>
          
          <div class="text-5xl font-display font-bold text-accent-600 mb-2">
            {stat.value}
          </div>
          
          <h3 class="font-display font-semibold text-primary-950 text-lg mb-3">
            {stat.label}
          </h3>
          
          <p class="text-primary-600 text-sm leading-relaxed">
            {stat.description}
          </p>
        </div>
      ))}
    </div>
    
    <!-- CTA -->
    <div class="mt-12 text-center">
      <p class="text-primary-700 font-medium mb-4">
        Hear AI calculate your missed call revenue potential
      </p>
      <a 
        href="tel:877-482-4368"
        class="btn-primary inline-flex items-center"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Call 877-482-4368
      </a>
    </div>
  </div>
</section>
