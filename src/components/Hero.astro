---
interface Props {
  headline?: string;
  subheadline?: string;
  showDemo?: boolean;
}

const { 
  headline = "Never Miss a Call or Lead Again",
  subheadline = "Turn your business into a 24/7 profit-generating machine with AI employees that qualify leads, schedule appointments, and manage customer service.",
  showDemo = true
} = Astro.props;
---

<section class="relative bg-gradient-hero overflow-hidden">
  <!-- Background Grid Pattern -->
  <div class="absolute inset-0 grid-bg"></div>
  
  <!-- Gradient Orbs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-primary-500/20 rounded-full blur-3xl"></div>
  
  <div class="relative container-width section-padding">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur rounded-full text-accent-300 text-sm font-medium mb-6 animate-fade-in">
          <span class="w-2 h-2 bg-accent-400 rounded-full animate-pulse"></span>
          AI-Powered Business Automation
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6 animate-fade-in-up">
          {headline.split(' ').map((word, i) => (
            i === headline.split(' ').length - 1 || word.toLowerCase() === 'ai' 
              ? <span class="text-gradient">{word} </span>
              : <span>{word} </span>
          ))}
        </h1>
        
        <p class="text-lg sm:text-xl text-primary-200 mb-8 max-w-xl mx-auto lg:mx-0 animate-fade-in-up animate-delay-100">
          {subheadline}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-fade-in-up animate-delay-200">
          <a href="/pricing" class="btn-primary text-lg px-8 py-4">
            Get Started
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a 
            href="tel:877-482-4368" 
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-white/10 backdrop-blur border border-white/20 rounded-lg transition-all duration-300 hover:bg-white/20"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Talk to AI Demo
          </a>
        </div>
        
        <!-- Trust Indicators -->
        <div class="mt-10 pt-8 border-t border-white/10 animate-fade-in-up animate-delay-300">
          <p class="text-primary-400 text-sm mb-4">Trusted by businesses across America</p>
          <div class="flex flex-wrap justify-center lg:justify-start gap-8">
            <div class="text-center">
              <div class="text-2xl font-bold text-white">24/7</div>
              <div class="text-primary-400 text-sm">Availability</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-white">85%</div>
              <div class="text-primary-400 text-sm">Calls Captured</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-white">60s</div>
              <div class="text-primary-400 text-sm">Avg Response</div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Demo Card -->
      {showDemo && (
        <div class="relative animate-fade-in-up animate-delay-400">
          <div class="card-dark p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 bg-accent-500/20 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-white text-lg">Try Our AI Voice Demo</h3>
                <p class="text-primary-400 text-sm">Call now to experience it yourself</p>
              </div>
            </div>
            
            <a 
              href="tel:877-482-4368"
              class="flex items-center justify-center gap-3 w-full py-4 bg-gradient-to-r from-accent-500 to-accent-600 rounded-xl text-white font-semibold text-lg transition-all duration-300 hover:shadow-lg hover:shadow-accent-500/30 animate-pulse-glow"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              877-482-4368
            </a>
            
            <div class="mt-6 grid grid-cols-3 gap-4">
              <div class="text-center p-3 bg-primary-800/50 rounded-lg">
                <div class="text-accent-400 font-bold">Roofing</div>
              </div>
              <div class="text-center p-3 bg-primary-800/50 rounded-lg">
                <div class="text-accent-400 font-bold">HVAC</div>
              </div>
              <div class="text-center p-3 bg-primary-800/50 rounded-lg">
                <div class="text-accent-400 font-bold">Plumbing</div>
              </div>
            </div>
            
            <p class="mt-4 text-primary-400 text-sm text-center">
              Hear how AI handles calls for different industries
            </p>
          </div>
          
          <!-- Decorative elements -->
          <div class="absolute -top-4 -right-4 w-24 h-24 bg-accent-500/10 rounded-full blur-2xl"></div>
          <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-primary-500/10 rounded-full blur-2xl"></div>
        </div>
      )}
    </div>
  </div>
</section>
