---
interface Props {
  headline?: string;
  subheadline?: string;
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  variant?: 'dark' | 'light' | 'gradient';
}

const {
  headline = "Ready to Never Miss a Call Again?",
  subheadline = "Let Creative Integrations work for your business 24/7. Plans start at $397/month.",
  primaryCta = { text: "Get Started", href: "/pricing" },
  secondaryCta = { text: "Talk to AI Demo", href: "tel:877-482-4368" },
  variant = 'dark'
} = Astro.props;

const bgClasses = {
  dark: 'bg-primary-950',
  light: 'bg-white',
  gradient: 'bg-gradient-hero'
};

const textClasses = {
  dark: 'text-white',
  light: 'text-primary-950',
  gradient: 'text-white'
};

const subtextClasses = {
  dark: 'text-primary-300',
  light: 'text-primary-600',
  gradient: 'text-primary-200'
};
---

<section class={`section-padding ${bgClasses[variant]} relative overflow-hidden`}>
  <!-- Background decoration -->
  {variant !== 'light' && (
    <>
      <div class="absolute inset-0 grid-bg"></div>
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-primary-500/10 rounded-full blur-3xl"></div>
    </>
  )}
  
  <div class="relative container-width">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class={`font-display text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 ${textClasses[variant]}`}>
        {headline}
      </h2>
      
      <p class={`text-lg sm:text-xl mb-8 ${subtextClasses[variant]}`}>
        {subheadline}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={primaryCta.href} 
          class="btn-primary text-lg px-8 py-4"
        >
          {primaryCta.text}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        
        {secondaryCta && (
          <a 
            href={secondaryCta.href} 
            class={`inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-lg transition-all duration-300 ${
              variant === 'light' 
                ? 'text-primary-700 bg-primary-100 hover:bg-primary-200' 
                : 'text-white bg-white/10 backdrop-blur border border-white/20 hover:bg-white/20'
            }`}
          >
            {secondaryCta.href.startsWith('tel:') && (
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            )}
            {secondaryCta.text}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
