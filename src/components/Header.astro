---
const navLinks = [
  { href: '/features', label: 'Features' },
  { href: '/industries', label: 'Industries' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/learn', label: 'Resources' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-lg border-b border-primary-100">
  <div class="container-width">
    <div class="flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img 
          src="/images/logo.png" 
          alt="Creative Integrations" 
          class="h-10 w-auto"
        />
      </a>
      
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class={`text-sm font-medium transition-colors duration-200 ${
              currentPath.startsWith(link.href) 
                ? 'text-accent-600' 
                : 'text-primary-700 hover:text-accent-600'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>
      
      <!-- CTA Buttons -->
      <div class="hidden md:flex items-center gap-4">
        <a 
          href="tel:877-482-4368" 
          class="flex items-center gap-2 text-sm font-medium text-primary-700 hover:text-accent-600 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Talk to AI Demo</span>
        </a>
        <a href="/pricing" class="btn-primary text-sm py-2">
          Get Started
        </a>
      </div>
      
      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden p-2 text-primary-700 hover:text-accent-600 transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-primary-100">
    <div class="px-4 py-4 space-y-3">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`block py-2 text-base font-medium ${
            currentPath.startsWith(link.href) 
              ? 'text-accent-600' 
              : 'text-primary-700'
          }`}
        >
          {link.label}
        </a>
      ))}
      <hr class="border-primary-100" />
      <a 
        href="tel:877-482-4368" 
        class="flex items-center gap-2 py-2 text-base font-medium text-primary-700"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Talk to AI Demo</span>
      </a>
      <a href="/pricing" class="btn-primary w-full text-center">
        Get Started
      </a>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16"></div>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
