---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs?: FAQ[];
  showSchema?: boolean;
}

const defaultFAQs: FAQ[] = [
  {
    question: "What are AI Employees?",
    answer: "AI Employees are advanced digital systems designed to autonomously perform tasks such as lead qualification, appointment scheduling, and customer service, thereby enhancing efficiency and customer engagement."
  },
  {
    question: "How do AI Voice and AI Chat Employees work?",
    answer: "AI Voice Employees interact with customers over the phone, understanding and responding to inquiries using natural language processing. AI Chat Employees engage with customers through text-based channels like SMS, web chat, and social media, providing instant support and information."
  },
  {
    question: "What are the benefits of using AI Employees for my business?",
    answer: "Implementing AI Employees ensures 24/7 availability, reduces missed calls, increases customer engagement, and allows your human staff to focus on more complex tasks, ultimately driving sales and enhancing customer satisfaction."
  },
  {
    question: "How much does an AI receptionist cost?",
    answer: "Our plans start at $397/month for the Pro plan which includes AI Voice Employee, webchat widget, and automated review responses. Premium is $697/month and Elite is $997/month with additional features like appointment booking and custom actions."
  },
  {
    question: "Can AI Employees handle multiple customer interactions simultaneously?",
    answer: "Yes, AI Employees are capable of managing numerous customer interactions at the same time, ensuring that all inquiries are addressed promptly without any wait time."
  },
  {
    question: "Do AI Employees sound natural, or do they sound robotic?",
    answer: "Our AI voices use advanced natural language processing and speech synthesis to sound as human-like as possible, ensuring a smooth and engaging customer experience. You can call our demo line at 877-482-4368 to hear it yourself."
  },
  {
    question: "How do AI Employees integrate with my existing systems?",
    answer: "Our AI Employees are designed to seamlessly integrate with your current CRM, scheduling tools, and other business systems, ensuring a smooth implementation without disrupting your existing workflows."
  },
  {
    question: "Is customer data secure with AI Employees?",
    answer: "We prioritize data security and comply with industry-standard protocols to ensure that all customer information handled by our AI Employees is protected and confidential."
  }
];

const { 
  title = "Frequently Asked Questions",
  faqs = defaultFAQs,
  showSchema = true
} = Astro.props;

// Generate FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="section-padding bg-white">
  <div class="container-width">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary-950 mb-4">
          {title}
        </h2>
        <p class="text-primary-600 text-lg">
          Answers to the most common questions about our AI Employees
        </p>
      </div>
      
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <details 
            class="group card overflow-hidden"
            id={`faq-${index}`}
          >
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-display font-semibold text-primary-950 text-lg pr-4">
                {faq.question}
              </h3>
              <span class="flex-shrink-0 w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center group-open:bg-accent-500 transition-colors duration-300">
                <svg 
                  class="w-4 h-4 text-primary-600 group-open:text-white group-open:rotate-180 transition-all duration-300" 
                  fill="none" 
                  stroke="currentColor" 
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6">
              <p class="text-primary-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          </details>
        ))}
      </div>
      
      <!-- CTA -->
      <div class="mt-12 text-center">
        <p class="text-primary-700 mb-4">
          Still have questions? Talk to our AI or reach out to our team.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:877-482-4368" class="btn-primary">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Talk to AI Demo
          </a>
          <a href="/contact" class="btn-secondary">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </div>
  
  {showSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</section>
