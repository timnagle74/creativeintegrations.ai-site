---
const currentYear = new Date().getFullYear();

const footerLinks = {
  product: [
    { href: '/features', label: 'Features' },
    { href: '/pricing', label: 'Pricing' },
    { href: '/industries', label: 'Industries' },
  ],
  resources: [
    { href: '/learn', label: 'Resources' },
    { href: '/learn/what-is-ai-receptionist', label: 'What is AI Receptionist?' },
    { href: '/faq', label: 'FAQ' },
  ],
  industries: [
    { href: '/industries/roofing', label: 'Roofing' },
    { href: '/industries/hvac', label: 'HVAC' },
    { href: '/industries/plumbing', label: 'Plumbing' },
    { href: '/industries/equine-transport', label: 'Equine Transport' },
  ],
  company: [
    { href: '/about', label: 'About' },
    { href: '/contact', label: 'Contact' },
    { href: '/privacy', label: 'Privacy Policy' },
    { href: '/terms', label: 'Terms of Service' },
  ],
};
---

<footer class="bg-primary-950 text-white">
  <!-- Main Footer -->
  <div class="container-width section-padding">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="col-span-2">
        <a href="/" class="inline-block mb-4">
          <img 
            src="/images/logo-white.png" 
            alt="Creative Integrations" 
            class="h-12 w-auto"
          />
        </a>
        <p class="text-primary-300 text-sm leading-relaxed mb-6 max-w-sm">
          Turn your business into a 24/7 profit-generating machine with AI employees that qualify leads, schedule appointments, and manage customer service.
        </p>
        <div class="flex flex-col gap-2">
          <a 
            href="tel:877-482-4368" 
            class="flex items-center gap-2 text-accent-400 hover:text-accent-300 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="font-medium">877-482-4368</span>
            <span class="text-primary-400 text-sm">(AI Demo)</span>
          </a>
          <a 
            href="tel:469-249-8057" 
            class="flex items-center gap-2 text-primary-300 hover:text-white transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="font-medium">469-249-8057</span>
            <span class="text-primary-400 text-sm">(Sales)</span>
          </a>
        </div>
      </div>
      
      <!-- Product Links -->
      <div>
        <h3 class="font-display font-semibold text-white mb-4">Product</h3>
        <ul class="space-y-2">
          {footerLinks.product.map((link) => (
            <li>
              <a href={link.href} class="text-primary-300 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Resources Links -->
      <div>
        <h3 class="font-display font-semibold text-white mb-4">Resources</h3>
        <ul class="space-y-2">
          {footerLinks.resources.map((link) => (
            <li>
              <a href={link.href} class="text-primary-300 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Industries Links -->
      <div>
        <h3 class="font-display font-semibold text-white mb-4">Industries</h3>
        <ul class="space-y-2">
          {footerLinks.industries.map((link) => (
            <li>
              <a href={link.href} class="text-primary-300 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Company Links -->
      <div>
        <h3 class="font-display font-semibold text-white mb-4">Company</h3>
        <ul class="space-y-2">
          {footerLinks.company.map((link) => (
            <li>
              <a href={link.href} class="text-primary-300 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  
  <!-- Bottom Bar -->
  <div class="border-t border-primary-800">
    <div class="container-width px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-primary-400 text-sm">
          © {currentYear} Creative Integrations. All rights reserved.
        </p>
        <div class="flex items-center gap-6">
          <a href="/privacy" class="text-primary-400 hover:text-white text-sm transition-colors">
            Privacy
          </a>
          <a href="/terms" class="text-primary-400 hover:text-white text-sm transition-colors">
            Terms
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
