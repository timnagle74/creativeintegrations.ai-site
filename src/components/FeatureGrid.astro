---
interface Feature {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  features?: Feature[];
}

const defaultFeatures: Feature[] = [
  {
    title: "AI Voice Employee",
    description: "Live voice conversations with all your inbound calls. Natural, intelligent responses 24/7.",
    icon: "microphone"
  },
  {
    title: "AI Chat Employee",
    description: "Engage leads across SMS, webchat, and social media. Instant responses that convert.",
    icon: "chat"
  },
  {
    title: "Live Call Transfer",
    description: "AI transfers calls to any number and sends texts with links to services when needed.",
    icon: "phone-forward"
  },
  {
    title: "Reviews Automation",
    description: "Get more reviews and have AI respond to them automatically to build trust.",
    icon: "star"
  },
  {
    title: "AI Appointment Booking",
    description: "Scheduling plus automated confirmation texts and reminders. Fill your calendar.",
    icon: "calendar"
  },
  {
    title: "AI Powered CRM",
    description: "All your leads and customers in one place with all the tools to manage them.",
    icon: "database"
  },
  {
    title: "2-Way Texting & Email",
    description: "Text, email, DM, Messenger, and WhatsApp all from one unified inbox.",
    icon: "mail"
  },
  {
    title: "Mobile App",
    description: "Manage all your leads, customers, and interactions from anywhere.",
    icon: "smartphone"
  },
  {
    title: "Automated Newsletters",
    description: "Answer a few questions and our AI will craft your monthly newsletter.",
    icon: "newspaper"
  }
];

const { 
  title = "Everything to Streamline and Grow Your Business",
  subtitle = "Access the tools, strategies, and insights you need to simplify operations, boost efficiency, and drive sustainable growth.",
  features = defaultFeatures
} = Astro.props;

const iconPaths: Record<string, string> = {
