---
/**
 * TabbedChatShowcase - Interactive tabbed section showing AI Chat across channels
 * Dark background with phone mockups and descriptions
 */

interface ChatTab {
  id: string;
  label: string;
  title: string;
  description: string;
  messages: {
    type: 'incoming' | 'outgoing';
    text: string;
  }[];
}

const tabs: ChatTab[] = [
  {
    id: 'sms',
    label: 'SMS',
    title: 'AI SMS',
    description: "Your leads are texting — are you responding fast enough? AI Chat engages instantly with inbound SMS, delivering answers, qualifying prospects, and moving them down your sales funnel 24/7. No more missed messages or delayed replies. Just fast, smart conversations that turn curious texters into paying customers.",
    messages: [
      { type: 'outgoing', text: "Hi, I saw your ad for roof inspections. Can you tell me more about it?" },
      { type: 'incoming', text: "Hi! Thanks for reaching out. We offer free roof inspections for homeowners. We'll check for damage, wear, and potential issues." },
      { type: 'incoming', text: "Would you like to schedule a free inspection? We have availability this week." },
      { type: 'outgoing', text: "Yes, what times work?" },
      { type: 'incoming', text: "We have Thursday at 10am or Friday at 2pm. Which works better for you?" },
    ]
  },
  {
    id: 'missed-call',
    label: 'Missed Call Text Back',
    title: 'Missed Call Text Back',
    description: "Most leads won't leave a voicemail — they'll call your competitor. With AI-powered Missed Call Text Back, every lost call becomes a new opportunity. Instantly text back missed calls, start the conversation, and let AI qualify and convert leads automatically — even while you sleep.",
    messages: [
      { type: 'incoming', text: "Hi there! I'm Alex from ABC Roofing. Sorry we missed your call, how can we help you?" },
      { type: 'outgoing', text: "I need a quote for roof repair. Had some storm damage." },
      { type: 'incoming', text: "Sorry to hear that! We can definitely help. What's your address so I can check our service area?" },
      { type: 'outgoing', text: "1234 Oak Street, Dallas" },
      { type: 'incoming', text: "Great, you're in our area! I can schedule a free inspection. Would tomorrow morning work?" },
    ]
  },
  {
    id: 'webchat',
    label: 'Webchat',
    title: 'Webchat',
    description: "Your website should do more than look pretty — it should convert. AI Chat engages visitors the moment they land, answers their questions, captures their info, and guides them toward buying decisions. It's like having your best salesperson on your homepage 24/7 — without taking lunch breaks.",
    messages: [
      { type: 'incoming', text: "Hello! Welcome to Creative Integrations. How can I assist you today?" },
      { type: 'outgoing', text: "Hi, I have a few questions about your services." },
      { type: 'incoming', text: "Of course! I'd be happy to help. What would you like to know?" },
      { type: 'outgoing', text: "How does the AI voice employee work?" },
      { type: 'incoming', text: "Great question! Our AI Voice Employee answers calls 24/7, qualifies leads, books appointments, and can transfer to your team when needed. Would you like to try a demo?" },
    ]
  },
  {
    id: 'meta',
    label: 'Meta Ad',
    title: 'Meta Ad',
    description: "Clicks are expensive — don't let them go to waste. AI Chat responds immediately when prospects engage with your Meta Ads, turning curiosity into conversations. Whether it's Messenger or comment triggers, your AI Chat is always ready to nurture leads and turn ad spend into ROI.",
    messages: [
      { type: 'outgoing', text: "I want to learn more about joining!" },
      { type: 'incoming', text: "Hello! Excited you're considering us. What's your experience in real estate?" },
      { type: 'outgoing', text: "I've been in real estate for 3 years, mostly residential. What kind of support do you offer?" },
      { type: 'incoming', text: "Great experience! We offer full marketing support, lead generation, and mentorship programs. Would you like to schedule a call to discuss?" },
    ]
  }
];
---

<section class="py-20 lg:py-28 bg-primary-950 relative overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-primary-500/20 rounded-full blur-3xl"></div>
  </div>
  
  <div class="container-width relative z-10">
    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-white mb-4">
        AI Chat Employee
      </h2>
      <p class="text-primary-300 text-lg">
        Engage with leads & customers on multiple channels.
      </p>
    </div>
    
    <!-- Tabs -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex bg-primary-800/50 rounded-full p-1.5" role="tablist">
        {tabs.map((tab, index) => (
          <button
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`panel-${tab.id}`}
            id={`tab-${tab.id}`}
            data-tab={tab.id}
            class:list={[
              "tab-button px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300",
              index === 0 ? "bg-white text-primary-950" : "text-primary-300 hover:text-white"
            ]}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>
    
    <!-- Tab Panels -->
    <div class="relative">
      {tabs.map((tab, index) => (
        <div
          role="tabpanel"
          id={`panel-${tab.id}`}
          aria-labelledby={`tab-${tab.id}`}
          data-panel={tab.id}
          class:list={[
            "tab-panel",
            index === 0 ? "block" : "hidden"
          ]}
        >
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Phone Mockup -->
            <div class="flex justify-center lg:justify-end">
              <div class="phone-mockup relative">
                <!-- Phone Frame -->
                <div class="w-[280px] sm:w-[320px] bg-gray-900 rounded-[3rem] p-3 shadow-2xl shadow-black/50 border border-gray-700">
                  <!-- Notch -->
                  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-7 bg-gray-900 rounded-b-2xl z-10"></div>
                  
                  <!-- Screen -->
                  <div class="bg-gray-100 rounded-[2.25rem] overflow-hidden">
                    <!-- Status Bar -->
                    <div class="bg-gray-100 px-6 py-2 flex justify-between items-center text-xs text-gray-800">
                      <span>9:41</span>
                      <div class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 3L2 12h3v8h14v-8h3L12 3z"/></svg>
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/></svg>
                        <svg class="w-6 h-3" fill="currentColor" viewBox="0 0 24 12"><rect x="0" y="0" width="22" height="12" rx="2" stroke="currentColor" stroke-width="1" fill="none"/><rect x="22" y="4" width="2" height="4" rx="1"/><rect x="2" y="2" width="18" height="8" rx="1"/></svg>
                      </div>
                    </div>
                    
                    <!-- Chat Header -->
                    <div class="bg-gray-100 px-4 py-3 flex items-center gap-3 border-b border-gray-200">
                      <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                      </svg>
                      <div class="w-10 h-10 bg-gradient-to-br from-blue-400 to-blue-600 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                      </div>
                      <div class="flex-1">
                        <div class="font-semibold text-gray-900 text-sm">Business Chat</div>
                        <div class="text-xs text-gray-500">Online</div>
                      </div>
                    </div>
                    
                    <!-- Messages -->
                    <div class="h-[380px] bg-white px-4 py-4 space-y-3 overflow-hidden">
                      {tab.messages.map((msg) => (
                        <div class:list={[
                          "max-w-[85%] animate-fade-in",
                          msg.type === 'outgoing' ? "ml-auto" : ""
                        ]}>
                          <div class:list={[
                            "px-4 py-2.5 rounded-2xl text-sm leading-relaxed",
                            msg.type === 'outgoing' 
                              ? "bg-blue-500 text-white rounded-br-md" 
                              : "bg-gray-200 text-gray-800 rounded-bl-md"
                          ]}>
                            {msg.text}
                          </div>
                        </div>
                      ))}
                    </div>
                    
                    <!-- Input Bar -->
                    <div class="bg-gray-100 px-4 py-3 flex items-center gap-2 border-t border-gray-200">
                      <div class="flex-1 bg-white rounded-full px-4 py-2 text-sm text-gray-400 border border-gray-200">
                        Message
                      </div>
                      <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                        </svg>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Description Card -->
            <div class="lg:pl-8">
              <div class="bg-white rounded-2xl p-8 shadow-xl max-w-md">
                <h3 class="font-display text-2xl font-bold text-primary-950 mb-4">
                  {tab.title}
                </h3>
                <p class="text-primary-600 leading-relaxed">
                  {tab.description}
                </p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- CTA -->
    <div class="text-center mt-16">
      <h3 class="font-display text-2xl sm:text-3xl font-bold text-white mb-6">
        See a Free Demo of an AI Chat Employee...
      </h3>
      <a 
        href="/contact#schedule" 
        class="inline-flex items-center gap-2 px-8 py-4 bg-accent-500 text-white font-semibold rounded-full hover:bg-accent-600 transition-colors shadow-lg shadow-accent-500/25"
      >
        Simulated On Your Website
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Tab functionality
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabPanels = document.querySelectorAll('.tab-panel');
  
  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tabId = button.getAttribute('data-tab');
      
      // Update buttons
      tabButtons.forEach(btn => {
        btn.classList.remove('bg-white', 'text-primary-950');
        btn.classList.add('text-primary-300');
        btn.setAttribute('aria-selected', 'false');
      });
      button.classList.add('bg-white', 'text-primary-950');
      button.classList.remove('text-primary-300');
      button.setAttribute('aria-selected', 'true');
      
      // Update panels
      tabPanels.forEach(panel => {
        if (panel.getAttribute('data-panel') === tabId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    });
  });
</script>
